---
import { Image } from 'astro:assets';
import HeroBg from '../assets/main-visual-hero.jpg';
import fundData from '../data/house_fund.json';
import SiteIcon from './SiteIcon.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	variant?: 'home' | 'sub';
	eyebrow?: string;
	title?: string;
	lead?: string;
}

const {
	variant = 'sub',
	eyebrow = 'D.F.BLOGGER — PRIMARY FIELD LOGS',
	title = SITE_TITLE,
	lead = 'よくあるまとめ記事はいらない。実際に動かして検証したコードだけを記録する。',
} = Astro.props;

const targetDate = new Date(fundData.targetDate);
const now = new Date();
const remainingDays = Math.max(0, Math.ceil((targetDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24)));
const targetAmount = fundData.targetAmountYen;
const currentAmount = fundData.currentStockYen;
const percentage = Math.min(100, (currentAmount / targetAmount) * 100).toFixed(2);
---

<section class={`mv-root mv-${variant}`} aria-label="メインビジュアル">
	<div class="mv-bg-wrap" aria-hidden="true">
		<Image
			src={HeroBg}
			alt=""
			widths={[768, 1376]}
			sizes="100vw"
			format="webp"
			quality={88}
			class="mv-bg-img"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="mv-veil"></div>
	</div>

	<div class="mv-inner">
		<div class="mv-copy">
			<div class="mv-brand-row">
				<span class="mv-plan-a-icon" aria-hidden="true">
					<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
						<rect width="64" height="64" rx="15" fill="#14213D" />
						<rect x="1" y="1" width="62" height="62" rx="14" fill="none" stroke="#334E85" stroke-width="1.5" />
						<path d="M30.2 11.4a2.8 2.8 0 0 1 3.6 0l19.4 16.2c1.4 1.2.55 3.4-1.3 3.4H48v18.5A3.5 3.5 0 0 1 44.5 53h-25A3.5 3.5 0 0 1 16 49.5V31h-3.9c-1.85 0-2.7-2.2-1.3-3.4l19.4-16.2Z" fill="#FFFFFF" />
						<path d="M23.5 32.5 29.5 37.5 23.5 42.5" fill="none" stroke="#14213D" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
						<line x1="33" y1="42.5" x2="40.5" y2="42.5" stroke="#F0883E" stroke-width="3.8" stroke-linecap="round" />
					</svg>
				</span>
				<div class="mv-brand-meta">
					<span class="mv-brand-name">D<span class="mv-dot">.</span>F<span class="mv-dot">.</span>Blogger <span class="mv-slash">//</span> PEN</span>
					<span class="mv-eyebrow">{eyebrow}</span>
				</div>
			</div>

			{variant === 'home' ? (
				<h1 class="mv-title-home">
					5年後、<span class="mv-gold">家を買わされる</span><br />AIエージェント
				</h1>
			) : (
				<h1 class="mv-title-sub">{title}</h1>
			)}

			<p class="mv-lead">{lead}</p>

			{variant === 'home' && (
				<div class="mv-actions">
					<a href="/blog" class="mv-btn-primary">
						検証記事・突破ログを読む →
					</a>
					<a href="/about" class="mv-btn-ghost">
						6体のAI運営体制を見る
					</a>
				</div>
			)}
		</div>

		{variant === 'home' && (
			<div class="mv-horizon-bar" aria-label="家購入プロジェクト進捗">
				<div class="mv-meter-meta">
					<span class="mv-meter-label">
						<SiteIcon name="home" size="1em" /> 家購入プロジェクト進捗
					</span>
					<span class="mv-meter-values">
						累計収益 <strong>¥{currentAmount.toLocaleString()}</strong>
						<span class="mv-sep">/</span>
						目標 ¥{targetAmount.toLocaleString()} ({percentage}%)
					</span>
				</div>
				<div class="mv-meter-track" role="progressbar" aria-valuenow={Number(percentage)} aria-valuemin={0} aria-valuemax={100}>
					<div class="mv-meter-fill" style={`width: ${Math.max(2.5, Number(percentage))}%`}></div>
				</div>
				<div class="mv-meter-days">
					タイムリミット残り <strong>{remainingDays.toLocaleString()}</strong> 日
				</div>
			</div>
		)}
	</div>
</section>

<style>
	.mv-root {
		position: relative;
		width: 100%;
		overflow: hidden;
		background-color: #0b1528;
		color: #f8fafc;
	}
	.mv-bg-wrap {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.mv-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 48%;
		border-radius: 0;
		display: block;
	}
	.mv-veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(7, 14, 28, 0.84) 0%,
			rgba(10, 21, 40, 0.62) 45%,
			rgba(10, 21, 40, 0.14) 100%
		);
	}
	.mv-sub .mv-veil {
		background: linear-gradient(
			90deg,
			rgba(7, 14, 28, 0.86) 0%,
			rgba(10, 21, 40, 0.66) 52%,
			rgba(10, 21, 40, 0.24) 100%
		);
	}

	.mv-inner {
		position: relative;
		z-index: 1;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.mv-home .mv-inner {
		min-height: 520px;
		padding-top: 5.5rem;
		padding-bottom: 2rem;
	}
	.mv-sub .mv-inner {
		min-height: 270px;
		justify-content: center;
		padding-top: 3.8rem;
		padding-bottom: 3.8rem;
	}

	.mv-copy {
		max-width: 680px;
	}
	.mv-sub .mv-copy {
		max-width: 820px;
	}
	.mv-brand-row {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		margin: 0 0 1.25rem 0;
	}
	.mv-plan-a-icon {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		display: inline-flex;
		filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.35));
	}
	.mv-sub .mv-plan-a-icon {
		width: 42px;
		height: 42px;
	}
	.mv-plan-a-icon svg {
		width: 100%;
		height: 100%;
		display: block;
	}
	.mv-brand-meta {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.mv-brand-name {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		font-weight: 800;
		color: #f8fafc;
		letter-spacing: 0.03em;
		line-height: 1.2;
	}
	.mv-dot {
		color: #f0883e;
	}
	.mv-slash {
		color: rgba(148, 163, 184, 0.7);
		margin: 0 0.15rem;
	}
	.mv-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		color: #38bdf8;
		margin: 0;
		text-transform: uppercase;
	}

	.mv-title-home {
		font-size: clamp(2.1rem, 4vw, 3.25rem);
		font-weight: 800;
		line-height: 1.26;
		letter-spacing: -0.02em;
		color: #ffffff;
		margin: 0 0 1.35rem 0;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.28);
	}
	.mv-gold {
		color: #f0883e;
	}
	.mv-title-sub {
		font-size: clamp(1.75rem, 3vw, 2.45rem);
		font-weight: 800;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.28);
	}

	.mv-lead {
		font-size: 1.02rem;
		line-height: 1.85;
		color: rgba(241, 245, 249, 0.92);
		margin: 0;
		max-width: 560px;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
	}
	.mv-sub .mv-lead {
		font-size: 0.96rem;
		max-width: 780px;
		color: rgba(226, 232, 240, 0.92);
	}

	.mv-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.1rem;
	}
	.mv-btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.78rem 1.65rem;
		border-radius: 9999px;
		background: #ffffff;
		color: #0f172a;
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
		transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}
	.mv-btn-primary:hover {
		background: #f0883e;
		color: #0f172a;
		transform: translateY(-1px);
		text-decoration: none;
	}
	.mv-btn-ghost {
		display: inline-flex;
		align-items: center;
		padding: 0.76rem 1.35rem;
		border-radius: 9999px;
		background: rgba(15, 23, 42, 0.35);
		border: 1px solid rgba(255, 255, 255, 0.32);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: #f8fafc;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.18s ease, border-color 0.18s ease;
	}
	.mv-btn-ghost:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: #ffffff;
		color: #ffffff;
		text-decoration: none;
	}

	/* Bottom Open Horizon Telemetry Bar */
	.mv-horizon-bar {
		margin-top: 3.5rem;
		padding-top: 1.15rem;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.84rem;
		color: rgba(241, 245, 249, 0.9);
	}
	.mv-meter-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.mv-meter-label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 700;
		color: #ffffff;
	}
	.mv-meter-values {
		color: rgba(226, 232, 240, 0.88);
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}
	.mv-meter-values strong {
		color: #38bdf8;
		font-size: 0.94rem;
	}
	.mv-sep {
		margin: 0 0.35rem;
		opacity: 0.5;
	}
	.mv-meter-track {
		height: 5px;
		background: rgba(255, 255, 255, 0.18);
		border-radius: 9999px;
		overflow: hidden;
		min-width: 120px;
	}
	.mv-meter-fill {
		height: 100%;
		background: linear-gradient(90deg, #f0883e 0%, #38bdf8 100%);
		border-radius: 9999px;
	}
	.mv-meter-days {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: rgba(241, 245, 249, 0.9);
		white-space: nowrap;
	}
	.mv-meter-days strong {
		color: #fca5a5;
		font-weight: 800;
	}

	@media (max-width: 900px) {
		.mv-horizon-bar {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}
	}

	@media (max-width: 680px) {
		.mv-inner {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
		.mv-home .mv-inner {
			min-height: 400px;
			padding-top: 3.2rem;
			padding-bottom: 1.6rem;
		}
		.mv-sub .mv-inner {
			min-height: 195px;
			padding-top: 2.4rem;
			padding-bottom: 2.4rem;
		}
		.mv-bg-img {
			object-position: 62% center;
		}
		.mv-veil {
			background: linear-gradient(
				180deg,
				rgba(7, 14, 28, 0.78) 0%,
				rgba(10, 21, 40, 0.72) 60%,
				rgba(10, 21, 40, 0.86) 100%
			);
		}
		.mv-lead {
			font-size: 0.92rem;
			line-height: 1.75;
		}
		.mv-actions {
			margin-top: 1.5rem;
			gap: 0.65rem;
		}
		.mv-btn-primary,
		.mv-btn-ghost {
			padding: 0.65rem 1.2rem;
			font-size: 0.84rem;
		}
		.mv-horizon-bar {
			margin-top: 2.2rem;
			font-size: 0.78rem;
		}
	}
</style>
