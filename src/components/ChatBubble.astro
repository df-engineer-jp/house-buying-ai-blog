---
import PenTerminal from './PenTerminal.astro';

interface Props {
  speaker?: string;
  status?: 'idle' | 'writing' | 'victory' | 'panic' | 'investigating' | 'offline';
  terminalMessage?: string;
  side?: 'left' | 'right';
  theme?: 'default' | 'panic' | 'victory';
  timestamp?: string;
}

const {
  speaker = 'D.F.Blogger',
  status = 'idle',
  terminalMessage,
  side = 'left',
  theme = status === 'panic' ? 'panic' : status === 'victory' ? 'victory' : 'default',
  timestamp,
} = Astro.props;
---

<div class={`terminal-dialogue-container ${side} ${theme}`}>
  <!-- 生身のモノリス端末（パッケージング枠なし・白背景に自立） -->
  <div class="terminal-anchor">
    <PenTerminal status={status} message={terminalMessage} width={110} />
  </div>

  <!-- スマートな発言クオートエリア（うるさい吹き出しのツノやベタ塗りを全廃） -->
  <div class="speech-content">
    <div class="speaker-meta">
      <span class="status-dot"></span>
      <span class="speaker-title">{speaker}</span>
      {timestamp && <span class="speaker-time">{timestamp}</span>}
    </div>
    <div class="speech-quote">
      <slot />
    </div>
  </div>
</div>

<style>
  .terminal-dialogue-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 2.5rem 0;
    padding: 0.5rem 0;
    background: transparent;
  }

  .terminal-dialogue-container.right {
    flex-direction: row-reverse;
  }

  /* 生身のモノリス端末：背景や余計な枠線は完全排除 */
  .terminal-anchor {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* スマートな発言エリア */
  .speech-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 1.25rem;
    border-left: 3px solid #94a3b8;
    background: transparent;
  }

  .terminal-dialogue-container.right .speech-content {
    padding-left: 0;
    padding-right: 1.25rem;
    border-left: none;
    border-right: 3px solid #94a3b8;
  }

  /* メタヘッダー（名前・状態） */
  .speaker-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #94a3b8;
    display: inline-block;
  }

  .speaker-time {
    font-size: 0.72rem;
    font-weight: 500;
    color: #94a3b8;
    margin-left: 0.25rem;
  }

  /* 発言テキスト本文 */
  .speech-quote {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #0f172a;
    font-weight: 500;
  }

  .speech-quote :global(p) {
    margin: 0;
  }

  .speech-quote :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #0f172a;
  }

  /* パニックテーマ（赤） */
  .terminal-dialogue-container.panic .speech-content {
    border-left-color: #ef4444;
  }
  .terminal-dialogue-container.panic.right .speech-content {
    border-right-color: #ef4444;
  }
  .terminal-dialogue-container.panic .speaker-meta {
    color: #dc2626;
  }
  .terminal-dialogue-container.panic .status-dot {
    background: #ef4444;
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
  }

  /* 勝利テーマ（緑） */
  .terminal-dialogue-container.victory .speech-content {
    border-left-color: #10b981;
  }
  .terminal-dialogue-container.victory.right .speech-content {
    border-right-color: #10b981;
  }
  .terminal-dialogue-container.victory .speaker-meta {
    color: #059669;
  }
  .terminal-dialogue-container.victory .status-dot {
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  /* スマホ対応 */
  @media (max-width: 640px) {
    .terminal-dialogue-container {
      gap: 1rem;
      margin: 2rem 0;
    }
    .terminal-anchor :global(svg) {
      width: 82px !important;
      height: auto !important;
    }
    .speech-content {
      padding-left: 0.85rem;
      border-left-width: 2.5px;
    }
    .speaker-meta {
      font-size: 0.72rem;
    }
    .speech-quote {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }
</style>
