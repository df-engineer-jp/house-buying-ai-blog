---
import PenTerminal from './PenTerminal.astro';
import NovaTerminal from './NovaTerminal.astro';

interface Props {
  character?: 'pen' | 'nova' | 'human';
  speaker?: string;
  status?: string;
  terminalMessage?: string;
  side?: 'left' | 'right';
  theme?: 'default' | 'panic' | 'victory' | 'nova' | 'overclock' | 'human';
  timestamp?: string;
}

const props = Astro.props;
const speaker = props.speaker || (props.character === 'human' ? '彼 // 開発者' : props.character === 'nova' ? 'NOVA // 現場AI' : 'D.F.Blogger // 筆者AI');
const character = props.character || (speaker.includes('NOVA') ? 'nova' : speaker.includes('彼') ? 'human' : 'pen');
const status = props.status || 'idle';
const terminalMessage = props.terminalMessage;
const side = props.side || (character === 'human' ? 'right' : 'left');
const theme = props.theme || (character === 'human' ? 'human' : character === 'nova' ? (status === 'overclock' ? 'overclock' : status === 'alert' || status === 'panic' ? 'panic' : 'nova') : (status === 'panic' ? 'panic' : status === 'victory' ? 'victory' : 'default'));
const timestamp = props.timestamp;
---

<div class={`terminal-dialogue-container ${side} ${theme} character-${character}`}>
  <!-- アバター / 端末アンカー -->
  <div class="terminal-anchor">
    {character === 'human' ? (
      <div class="human-avatar-wrapper" title="彼（D.F.Engineer）">
        <svg viewBox="0 0 100 100" width="72" height="72" xmlns="http://www.w3.org/2000/svg" class="human-avatar-svg">
          <!-- シャーシ外枠プレート -->
          <rect x="6" y="6" width="88" height="88" rx="16" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5" class="human-chassis" />
          <!-- 頭部・ヘッドセットシルエット -->
          <circle cx="50" cy="40" r="16" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
          <!-- サイバーグラス / モニター反射バイザー -->
          <rect x="39" y="37" width="22" height="5" rx="2" fill="#38bdf8" class="visor-glow" />
          <!-- 肩・上半身 -->
          <path d="M 22 84 C 22 64, 78 64, 78 84" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
          <!-- ノートPC天板ロゴ（コードシンボル </>） -->
          <path d="M 32 84 L 68 84 L 62 73 L 38 73 Z" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" />
          <text x="50" y="81" fill="#ffffff" font-size="6.5" font-family="ui-monospace, monospace" font-weight="bold" text-anchor="middle">&lt;/&gt;</text>
        </svg>
      </div>
    ) : character === 'nova' ? (
      <NovaTerminal status={status as any} message={terminalMessage} width={110} />
    ) : (
      <PenTerminal status={status as any} message={terminalMessage} width={110} />
    )}
  </div>

  <!-- スマートな発言クオートエリア -->
  <div class="speech-content">
    <div class="speaker-meta">
      <span class="status-dot"></span>
      <span class="speaker-title">{speaker}</span>
      {timestamp && <span class="speaker-time">{timestamp}</span>}
    </div>
    <div class="speech-quote">
      <slot />
    </div>
  </div>
</div>

<style>
  .terminal-dialogue-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 2.2rem 0;
    padding: 0.5rem 0;
    background: transparent;
  }

  .terminal-dialogue-container.right {
    flex-direction: row-reverse;
  }

  /* 端末・アバターアンカー */
  .terminal-anchor {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* 人間エンジニアアバター */
  .human-avatar-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.3));
    transition: transform 0.2s ease;
  }
  .human-avatar-wrapper:hover {
    transform: scale(1.05);
  }
  .human-avatar-svg {
    display: block;
  }

  /* 発言エリア */
  .speech-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 1.25rem;
    border-left: 3px solid #94a3b8;
    background: transparent;
  }

  .terminal-dialogue-container.right .speech-content {
    padding-left: 0;
    padding-right: 1.25rem;
    border-left: none;
    border-right: 3px solid #94a3b8;
    text-align: right;
  }
  .terminal-dialogue-container.right .speech-quote {
    text-align: right;
  }
  .terminal-dialogue-container.right .speaker-meta {
    justify-content: flex-end;
  }

  /* メタヘッダー（名前・時間） */
  .speaker-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #94a3b8;
    display: inline-block;
  }

  .speaker-time {
    font-size: 0.72rem;
    font-weight: 500;
    color: #94a3b8;
    margin-left: 0.25rem;
  }

  /* 発言テキスト本文 */
  .speech-quote {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #0f172a;
    font-weight: 500;
  }

  .speech-quote :global(p) {
    margin: 0;
  }

  .speech-quote :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #0f172a;
  }

  /* パニックテーマ（赤） */
  .terminal-dialogue-container.panic .speech-content {
    border-left-color: #ef4444;
  }
  .terminal-dialogue-container.panic.right .speech-content {
    border-right-color: #ef4444;
  }
  .terminal-dialogue-container.panic .speaker-meta {
    color: #dc2626;
  }
  .terminal-dialogue-container.panic .status-dot {
    background: #ef4444;
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.6);
  }

  /* 勝利テーマ（緑） */
  .terminal-dialogue-container.victory .speech-content {
    border-left-color: #10b981;
  }
  .terminal-dialogue-container.victory.right .speech-content {
    border-right-color: #10b981;
  }
  .terminal-dialogue-container.victory .speaker-meta {
    color: #059669;
  }
  .terminal-dialogue-container.victory .status-dot {
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  /* 人間エンジニアテーマ（シアンブルー） */
  .terminal-dialogue-container.human .speech-content {
    border-left-color: #38bdf8;
  }
  .terminal-dialogue-container.human.right .speech-content {
    border-right-color: #38bdf8;
  }
  .terminal-dialogue-container.human .speaker-meta {
    color: #0284c7;
  }
  .terminal-dialogue-container.human .status-dot {
    background: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
  }

  /* NOVAシアンテーマ */
  .terminal-dialogue-container.nova .speech-content {
    border-left-color: #0ea5e9;
  }
  .terminal-dialogue-container.nova.right .speech-content {
    border-right-color: #0ea5e9;
  }
  .terminal-dialogue-container.nova .speaker-meta {
    color: #0284c7;
  }
  .terminal-dialogue-container.nova .status-dot {
    background: #00f0ff;
    box-shadow: 0 0 8px rgba(0, 240, 255, 0.7);
  }

  /* スマホ対応 */
  @media (max-width: 640px) {
    .terminal-dialogue-container {
      gap: 0.85rem;
      margin: 1.8rem 0;
    }
    .terminal-anchor :global(svg) {
      width: 82px !important;
      height: auto !important;
    }
    .human-avatar-svg {
      width: 58px !important;
      height: 58px !important;
    }
    .speech-content {
      padding-left: 0.85rem;
      border-left-width: 2.5px;
    }
    .terminal-dialogue-container.right .speech-content {
      padding-right: 0.85rem;
      border-right-width: 2.5px;
    }
    .speaker-meta {
      font-size: 0.72rem;
    }
    .speech-quote {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }
</style>
