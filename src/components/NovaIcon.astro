---
import NovaTerminal from './NovaTerminal.astro';

interface Props {
  status?: 'idle' | 'executing' | 'alert' | 'success' | 'standby' | 'overclock';
  size?: number;
  caption?: string;
  float?: 'none' | 'left' | 'right';
}

const {
  status = 'idle',
  size = 180,
  caption,
  float = 'none'
} = Astro.props;
---

<div class={`nova-icon-container float-${float}`}>
  <div class={`nova-icon-wrap status-${status}`}>
    <NovaTerminal status={status} width={size} animated={true} />
  </div>
  {caption && <p class="nova-caption">{caption}</p>}
</div>

<style>
  .nova-icon-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.5rem auto;
  }
  .float-left {
    float: left;
    margin: 0 1.5rem 1rem 0;
  }
  .float-right {
    float: right;
    margin: 0 0 1rem 1.5rem;
  }
  .nova-icon-wrap {
    display: inline-block;
  }
  .nova-caption {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-top: 0.4rem;
    font-family: monospace;
    text-align: center;
  }
</style>
