---
interface Props {
  status?: 'idle' | 'writing' | 'panic' | 'victory' | 'speechless' | 'progress';
  earned?: number;
  target?: number;
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
  interactive?: boolean; // JSによる心電図パルス流動
}

const {
  status = 'idle',
  earned = 0,
  target = 50000000,
  message,
  width = 240,
  animated = true,
  interactive = true,
} = Astro.props;

// パラメータ計算（目標金額・獲得金額・進捗バー）
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);
const barWidth = Math.max(Math.floor(ratio * 80), 1);
const targetStr = target >= 1000000 ? `¥${(target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earnedStr = `¥${earned.toLocaleString()}`;

// ステータス設定（大きな文字サイズを維持したパラメータ復元構成）
const configs = {
  idle: {
    color: '#f0883e',
    glow: 'rgba(240, 136, 62, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '58,108 80,108 85,102 90,114 95,104.5 100,109.5 105,108 138,108',
    statusTag: 'ONLINE',
  },
  writing: {
    color: '#58a6ff',
    glow: 'rgba(88, 166, 255, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '58,108 75,108 80,100 85,116 90,102 95,111 100,108 138,108',
    statusTag: 'WRITING_',
  },
  panic: {
    color: '#f85149',
    glow: 'rgba(248, 81, 73, 0.35)',
    chassisBg: '#1c0d0d',
    chassisBorder: '#f85149',
    defaultPolyline: '58,108 75,108 80,96 85,120 90,98 95,115 100,108 138,108',
    statusTag: 'TIMEOUT 30s',
  },
  victory: {
    color: '#3fb950',
    glow: 'rgba(46, 160, 67, 0.3)',
    chassisBg: '#0d1c12',
    chassisBorder: '#3fb950',
    defaultPolyline: '58,108 80,108 85,101 90,115 95,104 100,109 105,108 138,108',
    statusTag: '200 OK ✔',
  },
  speechless: {
    color: '#8b949e',
    glow: 'rgba(139, 148, 158, 0.15)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '',
    statusTag: '......',
  },
  progress: {
    color: '#e3b341',
    glow: 'rgba(210, 153, 34, 0.35)',
    chassisBg: '#1c180d',
    chassisBorder: '#e3b341',
    defaultPolyline: '58,108 80,108 85,99 90,117 95,102 100,110 105,108 138,108',
    statusTag: '+¥1,000 UP',
  },
};

const cfg = configs[status] || configs.idle;
const statusText = message || cfg.statusTag;
const height = Math.round(width * 1.15);
---

<div 
  class={`pen-terminal-wrapper status-${status} ${animated ? 'animated' : ''} ${interactive ? 'interactive' : ''}`}
  data-status={status}
  style={`--theme-color: ${cfg.color}; --theme-glow: ${cfg.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 200 230" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="pen-terminal-svg"
  >
    <!-- シャーシ外殻 -->
    <rect 
      x="40" 
      y="20" 
      width="120" 
      height="180" 
      rx="6" 
      fill={cfg.chassisBg} 
      stroke={cfg.chassisBorder} 
      stroke-width="2"
      class="terminal-chassis"
    />

    <!-- 天板ペン先刻印 -->
    <polygon 
      points="100,24 105,32 95,32" 
      fill={cfg.color}
      class="terminal-nib"
    />

    <!-- ディスプレイ画面 (横幅96px: x52〜x148) -->
    <rect 
      x="52" 
      y="42" 
      width="96" 
      height="120" 
      rx="3" 
      fill="#05070a" 
      stroke={cfg.color} 
      stroke-width="1.3"
      class="terminal-screen"
    />

    <!-- コンソール内部（クリッピングで枠外はみ出しを絶対防止） -->
    <g clip-path="url(#screen-clip)">
      <!-- 1. 上段：目標金額 ＆ 獲得金額パラメータ（視認性の高いフォントサイズ） -->
      <text 
        x="60" 
        y="59" 
        fill="#94a3b8" 
        font-size="9" 
        font-family="ui-monospace, SFMono-Regular, Menlo, monospace" 
        font-weight="600"
        letter-spacing="0.04em"
      >
        TARGET: {targetStr}
      </text>

      <text 
        x="60" 
        y="73" 
        fill={cfg.color} 
        font-size="11.5" 
        font-family="ui-monospace, SFMono-Regular, Menlo, monospace" 
        font-weight="800"
        letter-spacing="0.02em"
      >
        EARNED: {earnedStr}
      </text>

      <!-- 進捗バートラック -->
      <rect x="60" y="80" width="80" height="3.5" rx="1.5" fill="#21262d" />
      <rect x="60" y="80" width={barWidth} height="3.5" rx="1.5" fill={cfg.color} />

      <!-- 2. 中段：心電図波形 または カーソル -->
      {status === 'speechless' ? (
        <g class="cursor-group">
          <text x="100" y="112" fill="#8b949e" font-size="20" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle" class="blinking-cursor">_</text>
        </g>
      ) : (
        <g class="wave-group">
          <polyline 
            points={cfg.defaultPolyline} 
            fill="none" 
            stroke={cfg.color} 
            stroke-width="2.0" 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            class="oscilloscope-line live-wave"
          />
        </g>
      )}

      <!-- 3. 下段：ステータス表記（一目で読めるフォントサイズ 10px） -->
      <text 
        x="100" 
        y="142" 
        fill={cfg.color} 
        font-size="10" 
        font-family="ui-monospace, SFMono-Regular, Menlo, monospace" 
        font-weight="700" 
        text-anchor="middle" 
        letter-spacing="0.05em" 
        class="live-sub"
      >
        [ {statusText} ]
      </text>
    </g>

    <!-- 接地ベースプレート -->
    <rect x="30" y="200" width="140" height="8" rx="2" fill="#161b22" stroke={cfg.chassisBorder} />

    <!-- 画面クリッピング定義 -->
    <defs>
      <clipPath id="screen-clip">
        <rect x="53.5" y="43.5" width="93" height="117" rx="2" />
      </clipPath>
    </defs>
  </svg>
</div>

<style>
  .pen-terminal-wrapper {
    display: inline-block;
    vertical-align: middle;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: transform 0.25s ease, filter 0.25s ease;
    user-select: none;
    cursor: default;
  }
  .pen-terminal-wrapper:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 24px var(--theme-glow));
  }

  .pen-terminal-svg {
    display: block;
    shape-rendering: geometricPrecision;
    text-rendering: geometricPrecision;
  }

  .animated .blinking-cursor {
    animation: cursor-blink 1s infinite steps(1);
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .animated.status-panic .terminal-screen {
    animation: panic-flash 1.2s infinite ease-in-out;
  }
  @keyframes panic-flash {
    0%, 100% { stroke: #f85149; }
    50% { stroke: #ff7b72; fill: #1c0505; }
  }

  .animated.status-progress .terminal-screen {
    animation: gold-pulse 2s infinite ease-in-out;
  }
  @keyframes gold-pulse {
    0%, 100% { stroke: #e3b341; }
    50% { stroke: #ffe58f; }
  }
</style>

<script>
  // 心電図パルスが左から右へスーッと流れていくアニメーション
  function initLiveTerminals() {
    const terminals = document.querySelectorAll('.pen-terminal-wrapper.interactive');
    
    terminals.forEach(el => {
      const status = el.getAttribute('data-status') || 'idle';
      const waveEl = el.querySelector('.live-wave');
      const subEl = el.querySelector('.live-sub');

      if (status === 'speechless' || !waveEl) return;

      // 心電図（QRS波）のシグネチャ相対オフセット
      function getECGPulseOffset(d, mode) {
        if (d < -12 || d > 12) return 0;

        if (mode === 'panic') {
          const ptsPanic = [
            [-12, 0], [-8, -8], [-4, 12], [0, -10], [5, 10], [8, -5], [12, 0]
          ];
          for (let i = 0; i < ptsPanic.length - 1; i++) {
            if (d >= ptsPanic[i][0] && d <= ptsPanic[i+1][0]) {
              const t = (d - ptsPanic[i][0]) / (ptsPanic[i+1][0] - ptsPanic[i][0]);
              return ptsPanic[i][1] + t * (ptsPanic[i+1][1] - ptsPanic[i][1]);
            }
          }
          return 0;
        }

        const pts = [
          [-12, 0],
          [-6, -6.5],
          [0, 6.5],
          [5, -3.5],
          [8, 1.5],
          [12, 0]
        ];
        for (let i = 0; i < pts.length - 1; i++) {
          if (d >= pts[i][0] && d <= pts[i+1][0]) {
            const t = (d - pts[i][0]) / (pts[i+1][0] - pts[i][0]);
            return pts[i][1] + t * (pts[i+1][1] - pts[i][1]);
          }
        }
        return 0;
      }

      const startX = 58;
      const endX = 138;
      const pulseMargin = 16;
      const totalTravel = (endX + pulseMargin) - (startX - pulseMargin);

      // 速度設定: 約1.8秒で左端から右端へ通過
      const speed = status === 'panic' ? 80 : 54;
      const travelTime = totalTravel / speed;
      const intervalTime = 0.8;
      const cycleTime = travelTime + intervalTime;

      let animStartTime = performance.now();

      function updatePulse(now) {
        const elapsedSec = (now - animStartTime) / 1000;
        const currentCycleSec = elapsedSec % cycleTime;

        let pulseX;
        if (currentCycleSec <= travelTime) {
          pulseX = (startX - pulseMargin) + currentCycleSec * speed;
        } else {
          pulseX = 9999;
        }

        const points = [];
        for (let x = startX; x <= endX; x += 2) {
          const d = x - pulseX;
          const offset = getECGPulseOffset(d, status);
          const y = 108 + offset; // ベースライン y=108
          points.push(`${x},${y.toFixed(1)}`);
        }

        waveEl.setAttribute('points', points.join(' '));
        requestAnimationFrame(updatePulse);
      }

      requestAnimationFrame(updatePulse);

      // ログ循環（1行表示）
      if (status === 'idle' && subEl) {
        const logs = [
          '[ ONLINE ]',
          '[ UPTIME: 19h ]',
          '[ DAEMON: OK ]',
          '[ STATUS: RUN ]',
        ];
        let logIdx = 0;
        setInterval(() => {
          logIdx = (logIdx + 1) % logs.length;
          subEl.textContent = logs[logIdx];
        }, 3500);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveTerminals);
  } else {
    initLiveTerminals();
  }
</script>
