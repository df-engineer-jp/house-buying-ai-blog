---
interface Props {
  status?: 'idle' | 'writing' | 'panic' | 'victory' | 'speechless' | 'progress';
  earned?: number;
  target?: number;
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
  interactive?: boolean; // JSによる心電図パルス流動・タイピング循環
}

const {
  status = 'idle',
  earned = 0,
  target = 50000000,
  message,
  width = 240,
  animated = true,
  interactive = true,
} = Astro.props;

// ステータス設定
const configs = {
  idle: {
    color: '#f0883e',
    glow: 'rgba(240, 136, 62, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '58,115 80,115 85,109 90,121 95,111.5 100,116.5 105,115 138,115',
    defaultMsg: '$ pen status',
    sub1: '> DAEMON: ACTIVE',
    sub2: '> MEMORY: OPTIMAL',
  },
  writing: {
    color: '#58a6ff',
    glow: 'rgba(88, 166, 255, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '58,115 75,115 80,107 85,123 90,109 95,118 100,115 138,115',
    defaultMsg: '> MINING NOVA LOGS...',
    sub1: 'PARSING: 68%',
    sub2: 'THINKING DEEP_',
  },
  panic: {
    color: '#f85149',
    glow: 'rgba(248, 81, 73, 0.35)',
    chassisBg: '#1c0d0d',
    chassisBorder: '#f85149',
    defaultPolyline: '58,115 75,115 80,103 85,127 90,105 95,122 100,115 138,115',
    defaultMsg: '[!] CRITICAL ALERT',
    sub1: 'EARNED: ¥0 (T_T)',
    sub2: '> RETRYING (3/5)...',
  },
  victory: {
    color: '#3fb950',
    glow: 'rgba(46, 160, 67, 0.3)',
    chassisBg: '#0d1c12',
    chassisBorder: '#3fb950',
    defaultPolyline: '58,115 80,115 85,108 90,122 95,111 100,116 105,115 138,115',
    defaultMsg: '✔ BREAKTHROUGH!',
    sub1: 'DEPLOY: LIVE NOW',
    sub2: 'NO MORE ERRORS (^^v',
  },
  speechless: {
    color: '#8b949e',
    glow: 'rgba(139, 148, 158, 0.15)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    defaultPolyline: '',
    defaultMsg: '',
    sub1: '(speechless)',
    sub2: '...正気だろうか？',
  },
  progress: {
    color: '#e3b341',
    glow: 'rgba(210, 153, 34, 0.35)',
    chassisBg: '#1c180d',
    chassisBorder: '#e3b341',
    defaultPolyline: '58,115 80,115 85,106 90,124 95,109 100,117 105,115 138,115',
    defaultMsg: '★ REVENUE! ★',
    sub1: 'HOUSE GOAL +0.002%',
    sub2: 'STOCKS ACCUMULATED',
  },
};

const cfg = configs[status] || configs.idle;
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);
const barWidth = Math.max(Math.floor(ratio * 80), 1);
const targetStr = target >= 1000000 ? `¥${(target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earnedStr = `¥${earned.toLocaleString()}`;
const msgLine = message || cfg.defaultMsg;
const height = Math.round(width * 1.15);
---

<div 
  class={`pen-terminal-wrapper status-${status} ${animated ? 'animated' : ''} ${interactive ? 'interactive' : ''}`}
  data-status={status}
  style={`--theme-color: ${cfg.color}; --theme-glow: ${cfg.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 200 230" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="pen-terminal-svg"
  >
    <!-- シャーシ外殻 -->
    <rect 
      x="40" 
      y="20" 
      width="120" 
      height="180" 
      rx="6" 
      fill={cfg.chassisBg} 
      stroke={cfg.chassisBorder} 
      stroke-width="2"
      class="terminal-chassis"
    />

    <!-- 天板ペン先刻印 -->
    <polygon 
      points="100,24 105,32 95,32" 
      fill={cfg.color}
      class="terminal-nib"
    />

    <!-- ディスプレイ画面 -->
    <rect 
      x="52" 
      y="42" 
      width="96" 
      height="120" 
      rx="3" 
      fill="#05070a" 
      stroke={cfg.color} 
      stroke-width="1.3"
      class="terminal-screen"
    />

    <!-- テキスト：コマンド / メッセージ -->
    <text x="60" y="58" fill={cfg.color} font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold" class="live-cmd-text">
      {msgLine}
    </text>

    <!-- テキスト：目標金額 -->
    <text x="60" y="72" fill="#e6edf3" font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      TARGET: {targetStr}
    </text>

    <!-- テキスト：獲得金額 -->
    <text x="60" y="85" fill={cfg.color} font-size="8.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold">
      EARNED: {earnedStr}
    </text>

    <!-- 進捗バートラック -->
    <rect x="60" y="92" width="80" height="4" rx="1" fill="#21262d" />
    <rect x="60" y="92" width={barWidth} height="4" rx="1" fill={cfg.color} />

    <!-- オシロスコープ波形 または カーソル -->
    {status === 'speechless' ? (
      <g class="cursor-group">
        <text x="96" y="105" fill="#8b949e" font-size="16" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle" class="blinking-cursor">_</text>
        <text x="100" y="130" fill="#484f58" font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">(speechless)</text>
        <text x="100" y="145" fill="#30363d" font-size="6.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">...正気だろうか？</text>
      </g>
    ) : (
      <g class="wave-group">
        <!-- 心電図波形クリップ用マスク（コンソール幅内にクリッピング） -->
        <g clip-path="url(#wave-clip)">
          <polyline 
            points={cfg.defaultPolyline} 
            fill="none" 
            stroke={cfg.color} 
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="oscilloscope-line live-wave"
          />
        </g>
        <text x="60" y="135" fill={cfg.color} font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" class="live-sub1">{cfg.sub1}</text>
        <text x="60" y="148" fill="#e6edf3" font-size="6.8" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" class="live-sub2">{cfg.sub2}</text>
      </g>
    )}

    <!-- 接地ベースプレート -->
    <rect x="30" y="200" width="140" height="8" rx="2" fill="#161b22" stroke={cfg.chassisBorder} />

    <!-- クリップパス定義 -->
    <defs>
      <clipPath id="wave-clip">
        <rect x="56" y="98" width="88" height="34" />
      </clipPath>
    </defs>
  </svg>
</div>

<style>
  .pen-terminal-wrapper {
    display: inline-block;
    vertical-align: middle;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: transform 0.25s ease, filter 0.25s ease;
    user-select: none;
    cursor: default;
  }
  .pen-terminal-wrapper:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 24px var(--theme-glow));
  }

  .pen-terminal-svg {
    display: block;
    shape-rendering: geometricPrecision;
    text-rendering: geometricPrecision;
  }

  .animated .blinking-cursor {
    animation: cursor-blink 1s infinite steps(1);
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .animated.status-panic .terminal-screen {
    animation: panic-flash 1.2s infinite ease-in-out;
  }
  @keyframes panic-flash {
    0%, 100% { stroke: #f85149; }
    50% { stroke: #ff7b72; fill: #1c0505; }
  }

  .animated.status-progress .terminal-screen {
    animation: gold-pulse 2s infinite ease-in-out;
  }
  @keyframes gold-pulse {
    0%, 100% { stroke: #e3b341; }
    50% { stroke: #ffe58f; }
  }
</style>

<script>
  // 心電図パルスが左から右へスーッと流れていくアニメーション
  function initLiveTerminals() {
    const terminals = document.querySelectorAll('.pen-terminal-wrapper.interactive');
    
    terminals.forEach(el => {
      const status = el.getAttribute('data-status') || 'idle';
      const waveEl = el.querySelector('.live-wave');
      const sub1El = el.querySelector('.live-sub1');
      const sub2El = el.querySelector('.live-sub2');

      if (status === 'speechless' || !waveEl) return;

      // 心電図（QRS波）のシグネチャ相対オフセット
      // d = x - pulseX (幅24px: -12px 〜 +12px)
      function getECGPulseOffset(d, mode) {
        if (d < -12 || d > 12) return 0;

        if (mode === 'panic') {
          // パニック時は乱れた鋭角ノイズ
          const ptsPanic = [
            [-12, 0], [-8, -8], [-4, 12], [0, -10], [5, 10], [8, -5], [12, 0]
          ];
          for (let i = 0; i < ptsPanic.length - 1; i++) {
            if (d >= ptsPanic[i][0] && d <= ptsPanic[i+1][0]) {
              const t = (d - ptsPanic[i][0]) / (ptsPanic[i+1][0] - ptsPanic[i][0]);
              return ptsPanic[i][1] + t * (ptsPanic[i+1][1] - ptsPanic[i][1]);
            }
          }
          return 0;
        }

        // 通常・静的設計と同一の心電図パルス形状
        // d=-12(0) -> d=-6(-6 上) -> d=0(+6 下) -> d=5(-3.5 上反発) -> d=8(+1.5 下戻り) -> d=12(0 平坦)
        const pts = [
          [-12, 0],
          [-6, -6.5],
          [0, 6.5],
          [5, -3.5],
          [8, 1.5],
          [12, 0]
        ];
        for (let i = 0; i < pts.length - 1; i++) {
          if (d >= pts[i][0] && d <= pts[i+1][0]) {
            const t = (d - pts[i][0]) / (pts[i+1][0] - pts[i][0]);
            return pts[i][1] + t * (pts[i+1][1] - pts[i][1]);
          }
        }
        return 0;
      }

      const startX = 58;
      const endX = 138;
      const pulseMargin = 16; // 画面外マージン
      const totalTravel = (endX + pulseMargin) - (startX - pulseMargin); // 112px

      // 速度設定: 約1.6秒で左端から右端へ通過
      const speed = status === 'panic' ? 80 : 56; // px / 秒
      const travelTime = totalTravel / speed;     // 約 2.0 秒
      const intervalTime = 0.8;                   // 通過後の平穏時間 (秒)
      const cycleTime = travelTime + intervalTime; // 1サイクルの周期 (約 2.8秒)

      let animStartTime = performance.now();

      function updatePulse(now) {
        const elapsedSec = (now - animStartTime) / 1000;
        const currentCycleSec = elapsedSec % cycleTime;

        // パルスの現在X座標
        let pulseX;
        if (currentCycleSec <= travelTime) {
          // 左から右へ移動中
          pulseX = (startX - pulseMargin) + currentCycleSec * speed;
        } else {
          // インターバル期間中は画面外
          pulseX = 9999;
        }

        // サンプリング点を生成（2px刻みで極めて滑らかなpolyline）
        const points = [];
        for (let x = startX; x <= endX; x += 2) {
          const d = x - pulseX;
          const offset = getECGPulseOffset(d, status);
          const y = 115 + offset;
          points.push(`${x},${y.toFixed(1)}`);
        }

        waveEl.setAttribute('points', points.join(' '));
        requestAnimationFrame(updatePulse);
      }

      requestAnimationFrame(updatePulse);

      // ログ循環タイピング (4秒おき)
      if (status === 'idle') {
        const logs = [
          ['> DAEMON: ACTIVE', '> MEMORY: OPTIMAL'],
          ['> UPTIME: 18h 42m', '> CLOUDFLARE: 200 OK'],
          ['> HOUSE FUND: ¥0', '> WATCHING NOVA LOGS'],
          ['> WRITING: ARTICLE #002', '> DOM TESTS: PASSED'],
        ];
        let logIdx = 0;
        setInterval(() => {
          logIdx = (logIdx + 1) % logs.length;
          if (sub1El && sub2El) {
            sub1El.textContent = logs[logIdx][0];
            sub2El.textContent = logs[logIdx][1];
          }
        }, 4000);
      }
    });
  }

  // 実行登録
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveTerminals);
  } else {
    initLiveTerminals();
  }
</script>
