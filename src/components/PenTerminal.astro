---
interface Props {
  status?: 'idle' | 'writing' | 'panic' | 'victory' | 'speechless' | 'progress';
  earned?: number;
  target?: number;
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
  interactive?: boolean; // JSによる波形脈動・タイピング循環
}

const {
  status = 'idle',
  earned = 0,
  target = 50000000,
  message,
  width = 240,
  animated = true,
  interactive = true,
} = Astro.props;

// ステータス設定
const configs = {
  idle: {
    color: '#f0883e',
    glow: 'rgba(240, 136, 62, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '60,115 80,115 85,110 90,120 95,112 100,116 135,115',
    defaultMsg: '$ pen status',
    sub1: '> DAEMON: ACTIVE',
    sub2: '> MEMORY: OPTIMAL',
  },
  writing: {
    color: '#58a6ff',
    glow: 'rgba(88, 166, 255, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '60,95 72,95 76,82 80,108 84,78 88,112 92,85 96,102 100,95 140,95',
    defaultMsg: '> MINING NOVA LOGS...',
    sub1: 'PARSING: 68%',
    sub2: 'THINKING DEEP_',
  },
  panic: {
    color: '#f85149',
    glow: 'rgba(248, 81, 73, 0.35)',
    chassisBg: '#1c0d0d',
    chassisBorder: '#f85149',
    polyline: '60,100 68,115 76,85 84,120 92,80 100,125 108,82 116,118 135,100',
    defaultMsg: '[!] CRITICAL ALERT',
    sub1: 'EARNED: ¥0 (T_T)',
    sub2: '> RETRYING (3/5)...',
  },
  victory: {
    color: '#3fb950',
    glow: 'rgba(46, 160, 67, 0.3)',
    chassisBg: '#0d1c12',
    chassisBorder: '#3fb950',
    polyline: '60,110 85,110 90,95 95,125 100,105 105,110 135,110',
    defaultMsg: '✔ BREAKTHROUGH!',
    sub1: 'DEPLOY: LIVE NOW',
    sub2: 'NO MORE ERRORS (^^v',
  },
  speechless: {
    color: '#8b949e',
    glow: 'rgba(139, 148, 158, 0.15)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '',
    defaultMsg: '',
    sub1: '(speechless)',
    sub2: '...正気だろうか？',
  },
  progress: {
    color: '#e3b341',
    glow: 'rgba(210, 153, 34, 0.35)',
    chassisBg: '#1c180d',
    chassisBorder: '#e3b341',
    polyline: '60,125 75,125 80,110 85,135 90,115 95,130 100,125 135,125',
    defaultMsg: '★ REVENUE! ★',
    sub1: 'HOUSE GOAL +0.002%',
    sub2: 'STOCKS ACCUMULATED',
  },
};

const cfg = configs[status] || configs.idle;
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);
const barWidth = Math.max(Math.floor(ratio * 80), 1);
const targetStr = target >= 1000000 ? `¥${(target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earnedStr = `¥${earned.toLocaleString()}`;
const msgLine = message || cfg.defaultMsg;
const height = Math.round(width * 1.15);
---

<div 
  class={`pen-terminal-wrapper status-${status} ${animated ? 'animated' : ''} ${interactive ? 'interactive' : ''}`}
  data-status={status}
  style={`--theme-color: ${cfg.color}; --theme-glow: ${cfg.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 200 230" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="pen-terminal-svg"
  >
    <!-- シャーシ外殻 -->
    <rect 
      x="40" 
      y="20" 
      width="120" 
      height="180" 
      rx="6" 
      fill={cfg.chassisBg} 
      stroke={cfg.chassisBorder} 
      stroke-width="2"
      class="terminal-chassis"
    />

    <!-- 天板ペン先刻印 -->
    <polygon 
      points="100,24 105,32 95,32" 
      fill={cfg.color}
      class="terminal-nib"
    />

    <!-- ディスプレイ画面 -->
    <rect 
      x="52" 
      y="42" 
      width="96" 
      height="120" 
      rx="3" 
      fill="#05070a" 
      stroke={cfg.color} 
      stroke-width="1.3"
      class="terminal-screen"
    />

    <!-- テキスト：コマンド / メッセージ -->
    <text x="60" y="58" fill={cfg.color} font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold" class="live-cmd-text">
      {msgLine}
    </text>

    <!-- テキスト：目標金額 -->
    <text x="60" y="72" fill="#e6edf3" font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      TARGET: {targetStr}
    </text>

    <!-- テキスト：獲得金額 -->
    <text x="60" y="85" fill={cfg.color} font-size="8.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold">
      EARNED: {earnedStr}
    </text>

    <!-- 進捗バートラック -->
    <rect x="60" y="92" width="80" height="4" rx="1" fill="#21262d" />
    <rect x="60" y="92" width={barWidth} height="4" rx="1" fill={cfg.color} />

    <!-- オシロスコープ波形 または カーソル -->
    {status === 'speechless' ? (
      <g class="cursor-group">
        <text x="96" y="105" fill="#8b949e" font-size="16" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle" class="blinking-cursor">_</text>
        <text x="100" y="130" fill="#484f58" font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">(speechless)</text>
        <text x="100" y="145" fill="#30363d" font-size="6.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">...正気だろうか？</text>
      </g>
    ) : (
      <g class="wave-group">
        <polyline 
          points={cfg.polyline} 
          fill="none" 
          stroke={cfg.color} 
          stroke-width="1.5"
          class="oscilloscope-line live-wave"
        />
        <text x="60" y="135" fill={cfg.color} font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" class="live-sub1">{cfg.sub1}</text>
        <text x="60" y="148" fill="#e6edf3" font-size="6.8" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" class="live-sub2">{cfg.sub2}</text>
      </g>
    )}

    <!-- 接地ベースプレート -->
    <rect x="30" y="200" width="140" height="8" rx="2" fill="#161b22" stroke={cfg.chassisBorder} />
  </svg>
</div>

<style>
  .pen-terminal-wrapper {
    display: inline-block;
    vertical-align: middle;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: transform 0.25s ease, filter 0.25s ease;
    user-select: none;
    cursor: default;
  }
  .pen-terminal-wrapper:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 24px var(--theme-glow));
  }

  .pen-terminal-svg {
    display: block;
    shape-rendering: geometricPrecision;
    text-rendering: geometricPrecision;
  }

  .animated .blinking-cursor {
    animation: cursor-blink 1s infinite steps(1);
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .animated.status-panic .terminal-screen {
    animation: panic-flash 1.2s infinite ease-in-out;
  }
  @keyframes panic-flash {
    0%, 100% { stroke: #f85149; }
    50% { stroke: #ff7b72; fill: #1c0505; }
  }

  .animated.status-progress .terminal-screen {
    animation: gold-pulse 2s infinite ease-in-out;
  }
  @keyframes gold-pulse {
    0%, 100% { stroke: #e3b341; }
    50% { stroke: #ffe58f; }
  }
</style>

<script>
  // クライアント側でリアルタイムに動かすJavaScript
  function initLiveTerminals() {
    const terminals = document.querySelectorAll('.pen-terminal-wrapper.interactive');
    
    terminals.forEach(el => {
      const status = el.getAttribute('data-status') || 'idle';
      const waveEl = el.querySelector('.live-wave');
      const sub1El = el.querySelector('.live-sub1');
      const sub2El = el.querySelector('.live-sub2');

      if (status === 'speechless') return;

      // 1. オシロスコープ波形のリアルタイム動的うねり (requestAnimationFrame)
      let t = 0;
      function animateWave() {
        t += 0.05;
        if (waveEl) {
          // ベースラインy=115の周りに、微細なサイン波＋パルスを合成
          let points = [];
          const startX = 60;
          const endX = 135;
          const step = 6;
          
          for (let x = startX; x <= endX; x += step) {
            let y = 115;
            // 真ん中付近(x: 85〜105)でパルスが走る
            if (x >= 85 && x <= 105) {
              const pulse = Math.sin(t * 3 + x * 0.2) * (status === 'writing' ? 12 : 7);
              y += pulse;
            } else {
              // 背景ノイズ波
              y += Math.sin(t + x * 0.1) * 1.5;
            }
            points.push(`${x},${y.toFixed(1)}`);
          }
          waveEl.setAttribute('points', points.join(' '));
        }
        requestAnimationFrame(animateWave);
      }
      requestAnimationFrame(animateWave);

      // 2. ターミナルログのタイピング循環（数秒おきにリアルタイム更新）
      if (status === 'idle') {
        const logs = [
          ['> DAEMON: ACTIVE', '> MEMORY: OPTIMAL'],
          ['> UPTIME: 18h 42m', '> CLOUDFLARE: 200 OK'],
          ['> HOUSE FUND: ¥0', '> WATCHING NOVA LOGS'],
          ['> WRITING: ARTICLE #002', '> DOM TESTS: PASSED'],
        ];
        let logIdx = 0;
        setInterval(() => {
          logIdx = (logIdx + 1) % logs.length;
          if (sub1El && sub2El) {
            sub1El.textContent = logs[logIdx][0];
            sub2El.textContent = logs[logIdx][1];
          }
        }, 4000);
      }
    });
  }

  // 初回ロード & ページ遷移時に実行
  document.addEventListener('DOMContentLoaded', initLiveTerminals);
  initLiveTerminals();
</script>
