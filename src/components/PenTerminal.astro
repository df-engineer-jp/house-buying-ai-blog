---
interface Props {
  status?: 'idle' | 'writing' | 'panic' | 'victory' | 'speechless' | 'progress';
  earned?: number;
  target?: number;
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
}

const {
  status = 'idle',
  earned = 0,
  target = 50000000,
  message,
  width = 240,
  animated = true,
} = Astro.props;

// ステータス設定
const configs = {
  idle: {
    color: '#f0883e',
    glow: 'rgba(240, 136, 62, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '60,115 80,115 85,110 90,120 95,112 100,116 135,115',
    defaultMsg: '$ pen status',
    sub1: '> DAEMON: ACTIVE',
    sub2: '> MEMORY: OPTIMAL',
  },
  writing: {
    color: '#58a6ff',
    glow: 'rgba(88, 166, 255, 0.25)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '60,95 72,95 76,82 80,108 84,78 88,112 92,85 96,102 100,95 140,95',
    defaultMsg: '> MINING NOVA LOGS...',
    sub1: 'PARSING: 68%',
    sub2: 'THINKING DEEP_',
  },
  panic: {
    color: '#f85149',
    glow: 'rgba(248, 81, 73, 0.35)',
    chassisBg: '#1c0d0d',
    chassisBorder: '#f85149',
    polyline: '60,100 68,115 76,85 84,120 92,80 100,125 108,82 116,118 135,100',
    defaultMsg: '[!] CRITICAL ALERT',
    sub1: 'EARNED: ¥0 (T_T)',
    sub2: '> RETRYING (3/5)...',
  },
  victory: {
    color: '#3fb950',
    glow: 'rgba(46, 160, 67, 0.3)',
    chassisBg: '#0d1c12',
    chassisBorder: '#3fb950',
    polyline: '60,110 85,110 90,95 95,125 100,105 105,110 135,110',
    defaultMsg: '✔ BREAKTHROUGH!',
    sub1: 'DEPLOY: LIVE NOW',
    sub2: 'NO MORE ERRORS (^^v',
  },
  speechless: {
    color: '#8b949e',
    glow: 'rgba(139, 148, 158, 0.15)',
    chassisBg: '#0d1117',
    chassisBorder: '#30363d',
    polyline: '',
    defaultMsg: '',
    sub1: '(speechless)',
    sub2: '...正気だろうか？',
  },
  progress: {
    color: '#e3b341',
    glow: 'rgba(210, 153, 34, 0.35)',
    chassisBg: '#1c180d',
    chassisBorder: '#e3b341',
    polyline: '60,125 75,125 80,110 85,135 90,115 95,130 100,125 135,125',
    defaultMsg: '★ REVENUE! ★',
    sub1: 'HOUSE GOAL +0.002%',
    sub2: 'STOCKS ACCUMULATED',
  },
};

const cfg = configs[status] || configs.idle;
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);
const barWidth = Math.max(Math.floor(ratio * 80), 1);
const targetStr = target >= 1000000 ? `¥${(target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earnedStr = `¥${earned.toLocaleString()}`;
const msgLine = message || cfg.defaultMsg;
const height = Math.round(width * 1.15);
---

<div 
  class={`pen-terminal-wrapper status-${status} ${animated ? 'animated' : ''}`}
  style={`--theme-color: ${cfg.color}; --theme-glow: ${cfg.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 200 230" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="pen-terminal-svg"
  >
    <!-- シャーシ外殻 -->
    <rect 
      x="40" 
      y="20" 
      width="120" 
      height="180" 
      rx="6" 
      fill={cfg.chassisBg} 
      stroke={cfg.chassisBorder} 
      stroke-width="2"
      class="terminal-chassis"
    />

    <!-- 天板ペン先刻印 -->
    <polygon 
      points="100,24 105,32 95,32" 
      fill={cfg.color}
      class="terminal-nib"
    />

    <!-- ディスプレイ画面 -->
    <rect 
      x="52" 
      y="42" 
      width="96" 
      height="120" 
      rx="3" 
      fill="#05070a" 
      stroke={cfg.color} 
      stroke-width="1.3"
      class="terminal-screen"
    />

    <!-- テキスト：コマンド / 警告 -->
    <text x="60" y="58" fill={cfg.color} font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold">
      {msgLine}
    </text>

    <!-- テキスト：目標金額 -->
    <text x="60" y="72" fill="#e6edf3" font-size="7.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">
      TARGET: {targetStr}
    </text>

    <!-- テキスト：獲得金額 -->
    <text x="60" y="85" fill={cfg.color} font-size="8.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-weight="bold">
      EARNED: {earnedStr}
    </text>

    <!-- 進捗バートラック -->
    <rect x="60" y="92" width="80" height="4" rx="1" fill="#21262d" />
    <rect x="60" y="92" width={barWidth} height="4" rx="1" fill={cfg.color} />

    <!-- オシロスコープ波形 または カーソル -->
    {status === 'speechless' ? (
      <g class="cursor-group">
        <text x="96" y="105" fill="#8b949e" font-size="16" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle" class="blinking-cursor">_</text>
        <text x="100" y="130" fill="#484f58" font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">(speechless)</text>
        <text x="100" y="145" fill="#30363d" font-size="6.5" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" text-anchor="middle">...正気だろうか？</text>
      </g>
    ) : (
      <g class="wave-group">
        <polyline 
          points={cfg.polyline} 
          fill="none" 
          stroke={cfg.color} 
          stroke-width="1.5"
          class="oscilloscope-line"
        />
        <text x="60" y="135" fill={cfg.color} font-size="7" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">{cfg.sub1}</text>
        <text x="60" y="148" fill="#e6edf3" font-size="6.8" font-family="ui-monospace, SFMono-Regular, Menlo, monospace">{cfg.sub2}</text>
      </g>
    )}

    <!-- 接地ベースプレート -->
    <rect x="30" y="200" width="140" height="8" rx="2" fill="#161b22" stroke={cfg.chassisBorder} />
  </svg>
</div>

<style>
  .pen-terminal-wrapper {
    display: inline-block;
    vertical-align: middle;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: transform 0.25s ease, filter 0.25s ease;
    user-select: none;
  }
  .pen-terminal-wrapper:hover {
    transform: scale(1.03);
    filter: drop-shadow(0 0 24px var(--theme-glow));
  }

  /* 生SVGのベクター鮮明度 */
  .pen-terminal-svg {
    display: block;
    shape-rendering: geometricPrecision;
    text-rendering: geometricPrecision;
  }

  /* CSSアニメーション */
  .animated .blinking-cursor {
    animation: cursor-blink 1s infinite steps(1);
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .animated.status-panic .terminal-screen {
    animation: panic-flash 1.2s infinite ease-in-out;
  }
  @keyframes panic-flash {
    0%, 100% { stroke: #f85149; }
    50% { stroke: #ff7b72; fill: #1c0505; }
  }

  .animated.status-progress .terminal-screen {
    animation: gold-pulse 2s infinite ease-in-out;
  }
  @keyframes gold-pulse {
    0%, 100% { stroke: #e3b341; }
    50% { stroke: #ffe58f; }
  }

  .animated.status-writing .oscilloscope-line {
    animation: wave-jitter 0.8s infinite ease-in-out alternate;
  }
  @keyframes wave-jitter {
    0% { transform: translateY(0); }
    100% { transform: translateY(-1px); }
  }
</style>
