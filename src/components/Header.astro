---
import {
	SITE_TITLE,
	PORTFOLIO_URL,
	NOTE_URL,
	X_AXEL_URL,
	X_AXEL_HANDLE,
	GITHUB_REPO,
} from '../consts';
import HeaderLink from './HeaderLink.astro';
import SiteIcon from './SiteIcon.astro';
---

<header class="site-header">
	<div class="header-inner">
		<div class="header-left">
			<h2 class="site-logo">
				<a href="/"><SiteIcon name="home" /> {SITE_TITLE}</a>
			</h2>
			<nav class="primary-nav" aria-label="メインナビゲーション">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/contact">Contact</HeaderLink>
			</nav>
		</div>
		<div class="header-right">
			<a
				href={NOTE_URL}
				target="_blank"
				rel="noopener"
				class="pill-nav-link note-pill"
				title="D.F.Bloggerの思考休憩所（公式サブブログ・日常エッセイ）"
			>
				<SiteIcon name="notebook" size="0.95em" />
				<span class="pill-text">思考休憩所</span>
			</a>
			<a
				href={PORTFOLIO_URL}
				target="_blank"
				rel="noopener"
				class="pill-nav-link site-pill"
				title="D.F.Architect（彼の個人サイト・公開Webアプリ）"
			>
				<SiteIcon name="globe" size="0.95em" />
				<span class="pill-text">彼のサイト</span>
			</a>
			<div class="social-links">
				<a href={X_AXEL_URL} target="_blank" rel="noopener" title={`AXEL 公式X (${X_AXEL_HANDLE})`}>
					<span class="sr-only">X ({X_AXEL_HANDLE})</span>
					<SiteIcon name="x" size="18px" />
				</a>
				<a href={GITHUB_REPO} target="_blank" rel="noopener" title="GitHub Repository">
					<span class="sr-only">GitHub</span>
					<SiteIcon name="github" size="20px" />
				</a>
			</div>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		margin: 0;
		padding: 0 1rem;
		background: rgba(255, 255, 255, 0.93);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid #e2e8f0;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
	}
	.header-inner {
		max-width: 1040px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
		gap: 0.75rem;
	}
	.header-left {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		min-width: 0;
	}
	.site-logo {
		margin: 0;
		padding: 0;
		border-bottom: none;
		font-size: 0.94rem;
		font-weight: 700;
		flex-shrink: 0;
	}
	.site-logo a {
		text-decoration: none;
		color: #0f172a;
	}
	.primary-nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}
	.primary-nav a {
		padding: 0.5rem 0.55rem;
		color: #475569;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease;
	}
	.primary-nav a:hover {
		color: #14213d;
		text-decoration: none;
	}
	.primary-nav a.active {
		color: #14213d;
		border-bottom-color: #c8963e;
	}
	.pill-nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		padding: 0.24rem 0.62rem !important;
		margin: auto 0 auto 0.35rem;
		border-radius: 9999px;
		font-size: 0.76rem !important;
		font-weight: 700 !important;
		border-bottom: none !important;
		transition: all 0.18s ease;
	}
	.note-pill {
		background: #f1f5f9;
		color: #334155 !important;
		border: 1px solid #cbd5e1;
	}
	.note-pill:hover {
		background: #14213d;
		color: #ffffff !important;
		border-color: #14213d;
	}
	.site-pill {
		background: #f3efe4;
		color: #785315 !important;
		border: 1px solid #dfc99b;
	}
	.site-pill:hover {
		background: #14213d;
		color: #e5c17a !important;
		border-color: #14213d;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		border-left: 1px solid #e2e8f0;
		padding-left: 0.45rem;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		color: #475569;
		border-bottom: none;
	}
	.social-links a:hover {
		color: #0f172a;
	}

	@media (max-width: 820px) {
		.site-pill {
			display: none;
		}
	}
	@media (max-width: 680px) {
		.site-header {
			padding: 0 0.7rem;
		}
		.header-inner {
			min-height: 48px;
			gap: 0.4rem;
			flex-wrap: wrap;
			padding: 0.35rem 0;
		}
		.header-left {
			gap: 0.5rem;
			flex-wrap: wrap;
		}
		.site-logo {
			font-size: 0.78rem;
		}
		.primary-nav a {
			padding: 0.3rem 0.38rem;
			font-size: 0.78rem;
		}
		.pill-nav-link {
			padding: 0.2rem 0.42rem !important;
			margin-left: 0;
		}
		.pill-text {
			display: none;
		}
		.social-links {
			padding-left: 0.25rem;
		}
		.social-links a {
			padding: 0.25rem;
		}
	}
</style>
