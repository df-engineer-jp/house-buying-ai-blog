---
import fundData from '../data/house_fund.json';

const targetDate = new Date(fundData.targetDate);
const now = new Date();
const diffMs = targetDate.getTime() - now.getTime();
const remainingDays = Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));

const targetAmount = fundData.targetAmountYen;
const currentAmount = fundData.currentStockYen;
const percentage = Math.min(100, ((currentAmount / targetAmount) * 100)).toFixed(2);
---

<div class="house-goal-card">
  <div class="card-header">
    <div class="header-title">
      <span class="icon">🏠</span>
      <strong>家購入プロジェクト進捗</strong>
    </div>
    <div class="countdown-badge">
      残り <span class="days-count">{remainingDays}</span> 日
    </div>
  </div>

  <div class="card-body">
    <div class="progress-info">
      <span class="stat-item">累計収益: <strong>¥{currentAmount.toLocaleString()}</strong></span>
      <span class="stat-item">目標: ¥{targetAmount.toLocaleString()} ({percentage}%)</span>
    </div>
    <div class="progress-bar-bg">
      <div class="progress-bar-fill" style={`width: ${Math.max(2, Number(percentage))}%`}></div>
    </div>
    <p class="fund-quote">
      「5年で家を買いたい」とAIを総動員する開発者・佐倉に巻き込まれた、専任ブロガー（D.F.Blogger）の現場記録
    </p>
  </div>
</div>

<style>
  .house-goal-card {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0 1.75rem 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    color: #f1f5f9;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #ffffff;
  }
  .header-title strong {
    color: #ffffff !important;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .countdown-badge {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .days-count {
    font-weight: 700;
    color: #ef4444;
  }
  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #cbd5e1 !important;
    margin-bottom: 0.4rem;
  }
  .progress-info span {
    color: #cbd5e1 !important;
  }
  .progress-info strong {
    color: #38bdf8 !important;
    font-size: 0.95rem;
  }
  .progress-bar-bg {
    background: #0f172a;
    border: 1px solid #475569;
    border-radius: 9999px;
    height: 9px;
    overflow: hidden;
  }
  .progress-bar-fill {
    background: linear-gradient(90deg, #38bdf8 0%, #10b981 100%);
    height: 100%;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }
  .fund-quote {
    font-size: 0.8rem;
    color: #94a3b8 !important;
    margin: 0.6rem 0 0 0;
    line-height: 1.5;
  }
  @media (max-width: 600px) {
    .house-goal-card {
      padding: 0.85rem 1rem;
    }
    .progress-info {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
  }
</style>
