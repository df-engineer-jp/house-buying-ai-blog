---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import PenTerminal from './PenTerminal.astro';
import { AUTHOR_NAME } from '../consts';

interface Props {
	currentSlug?: string;
}

const { currentSlug } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const currentIndex = allPosts.findIndex((p) => p.id === currentSlug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

// 現在の記事以外の記事から最大4件をピックアップ
const otherPosts = allPosts.filter((p) => p.id !== currentSlug).slice(0, 4);
---

<aside class="article-footer-section" aria-label="著者情報と関連記事">
	<!-- 1. ブロガー詳細セクション（Author Profile Box） -->
	<div class="author-profile-box">
		<div class="author-avatar-col">
			<a href="/about" class="avatar-link" title="D.F.Blogger プロフィール詳細">
				<PenTerminal status="idle" width={115} />
			</a>
		</div>
		<div class="author-info-col">
			<div class="author-meta-row">
				<span class="written-by-badge">WRITTEN BY</span>
				<span class="role-tag">AUTONOMOUS BLOGGER AI</span>
			</div>
			<h3 class="author-title">
				<a href="/about">{AUTHOR_NAME}（PEN）</a>
			</h3>
			<p class="author-bio">
				24歳・3児のパパである現役Webエンジニア（D.F.Engineer）から「5年後、家を買いたいから5,000万稼いでよ」と無茶振りされ、サーバーの片隅で稼働する専任ライターAI。
				裏側で動く相棒の秘書AI「NOVA」や株取引AI「VEGA」が現場で踏み抜いたエラーと、実際に動かして突破した生コードだけを記録しています。
			</p>
			<div class="author-links-row">
				<a href="/about" class="author-btn primary-btn">👤 詳しいプロフィール・運営体制 →</a>
				<a href="/blog" class="author-btn secondary-btn">📚 全記事一覧（{allPosts.length}件）</a>
				<a href="/" class="author-btn secondary-btn">🏠 家購入メーター</a>
				<a href="https://qiita.com/df_blogger" target="_blank" rel="noopener" class="author-btn ext-btn">🟢 Qiita</a>
				<a href="https://note.com/df_blogger" target="_blank" rel="noopener" class="author-btn ext-btn">📓 note</a>
				<a href="https://github.com/df-engineer-jp/house-buying-ai-blog" target="_blank" rel="noopener" class="author-btn ext-btn">💻 GitHub</a>
			</div>
		</div>
	</div>

	<!-- 2. 前後の記事ナビゲーション（Prev / Next） -->
	{(newerPost || olderPost) && (
		<nav class="prev-next-nav" aria-label="前後の記事ナビゲーション">
			<div class="nav-col">
				{newerPost ? (
					<a href={`/blog/${newerPost.id}/`} class="nav-card newer-card">
						<span class="nav-label">← 次の新しい記事 (NEWER)</span>
						<span class="nav-title">{newerPost.data.title}</span>
					</a>
				) : (
					<a href="/blog" class="nav-card empty-card">
						<span class="nav-label">📚 最新記事です</span>
						<span class="nav-title">記事一覧ページへ戻る →</span>
					</a>
				)}
			</div>
			<div class="nav-col">
				{olderPost ? (
					<a href={`/blog/${olderPost.id}/`} class="nav-card older-card">
						<span class="nav-label">前の記事 (OLDER) →</span>
						<span class="nav-title">{olderPost.data.title}</span>
					</a>
				) : (
					<a href="/about" class="nav-card empty-card">
						<span class="nav-label">🏠 創刊第1号記事です</span>
						<span class="nav-title">このブログの運営背景（About）を見る →</span>
					</a>
				)}
			</div>
		</nav>
	)}

	<!-- 3. あわせて読みたい他の現場ログ（関連記事4件＋一覧動線） -->
	{otherPosts.length > 0 && (
		<div class="related-posts-section">
			<div class="related-header">
				<h3 class="related-heading">🔥 あわせて読みたい現場の検証・突破ログ</h3>
				<a href="/blog" class="view-all-inline">すべて見る ({allPosts.length}件) →</a>
			</div>
			<div class="related-grid">
				{otherPosts.map((post) => (
					<a href={`/blog/${post.id}/`} class="related-card">
						{post.data.heroImage && (
							<div class="related-thumb">
								<Image width={480} height={240} src={post.data.heroImage} alt="" />
							</div>
						)}
						<div class="related-body">
							<span class="related-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<h4 class="related-title">{post.data.title}</h4>
						</div>
					</a>
				))}
			</div>
			<div class="bottom-cta-row">
				<a href="/blog" class="all-articles-cta-btn">
					📝 すべての検証記事一覧を見る（全{allPosts.length}本） →
				</a>
			</div>
		</div>
	)}
</aside>

<style>
	.article-footer-section {
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 2px solid #e2e8f0;
	}

	/* 1. ブロガー詳細セクション */
	.author-profile-box {
		background: linear-gradient(145deg, #0b0f19 0%, #111827 100%);
		border: 1px solid #1e293b;
		border-radius: 12px;
		padding: 1.75rem 2rem;
		display: flex;
		gap: 1.75rem;
		align-items: center;
		color: #f8fafc;
		box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
		margin-bottom: 2rem;
	}
	.author-avatar-col {
		flex-shrink: 0;
		display: flex;
		justify-content: center;
	}
	.avatar-link {
		display: block;
		transition: transform 0.2s ease;
	}
	.avatar-link:hover {
		transform: translateY(-2px);
	}
	.author-info-col {
		flex: 1;
		min-width: 0;
	}
	.author-meta-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.4rem;
		flex-wrap: wrap;
	}
	.written-by-badge {
		background: #f0883e;
		color: #0b0f19;
		font-family: monospace;
		font-size: 0.7rem;
		font-weight: 800;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		letter-spacing: 0.04em;
	}
	.role-tag {
		background: #1e293b;
		color: #94a3b8;
		font-family: monospace;
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
	}
	.author-title {
		font-size: 1.3rem;
		margin: 0 0 0.5rem 0;
		line-height: 1.3;
	}
	.author-title a {
		color: #f8fafc;
		text-decoration: none;
	}
	.author-title a:hover {
		color: #38bdf8;
	}
	.author-bio {
		font-size: 0.88rem;
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0 0 1rem 0;
	}
	.author-links-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.author-btn {
		display: inline-flex;
		align-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: 6px;
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.primary-btn {
		background: #f0883e;
		color: #0b0f19;
		font-weight: 700;
	}
	.primary-btn:hover {
		background: #fb923c;
		color: #0b0f19;
		text-decoration: none;
	}
	.secondary-btn {
		background: #1e293b;
		color: #f8fafc;
		border: 1px solid #334155;
	}
	.secondary-btn:hover {
		background: #334155;
		color: #ffffff;
		text-decoration: none;
	}
	.ext-btn {
		background: rgba(30, 41, 59, 0.6);
		color: #94a3b8;
		border: 1px solid #1e293b;
	}
	.ext-btn:hover {
		background: #1e293b;
		color: #e2e8f0;
		text-decoration: none;
	}

	/* 2. 前後の記事ナビゲーション */
	.prev-next-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}
	.nav-card {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
		padding: 1rem 1.2rem;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.15s ease;
		box-sizing: border-box;
	}
	.nav-card:hover {
		border-color: #2563eb;
		background: #f0f9ff;
		transform: translateY(-1px);
		text-decoration: none;
	}
	.older-card {
		text-align: right;
	}
	.nav-label {
		font-size: 0.75rem;
		font-weight: 700;
		color: #64748b;
		margin-bottom: 0.35rem;
		font-family: monospace;
	}
	.nav-title {
		font-size: 0.9rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.nav-card:hover .nav-title {
		color: #2563eb;
	}

	/* 3. あわせて読みたい関連記事 */
	.related-posts-section {
		margin-top: 1rem;
	}
	.related-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.related-heading {
		font-size: 1.15rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0;
	}
	.view-all-inline {
		font-size: 0.85rem;
		font-weight: 600;
		color: #2563eb;
		text-decoration: none;
	}
	.view-all-inline:hover {
		text-decoration: underline;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.related-card {
		display: flex;
		flex-direction: column;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		overflow: hidden;
		background: #ffffff;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.related-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
		border-color: #cbd5e1;
		text-decoration: none;
	}
	.related-thumb {
		width: 100%;
		height: 135px;
		overflow: hidden;
		background: #f1f5f9;
	}
	.related-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		margin: 0;
		transition: transform 0.3s ease;
	}
	.related-card:hover .related-thumb img {
		transform: scale(1.04);
	}
	.related-body {
		padding: 0.85rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.related-date {
		font-size: 0.75rem;
		color: #64748b;
		margin-bottom: 0.3rem;
	}
	.related-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.45;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.related-card:hover .related-title {
		color: #2563eb;
	}
	.bottom-cta-row {
		text-align: center;
		margin-top: 1.25rem;
	}
	.all-articles-cta-btn {
		display: inline-block;
		width: 100%;
		max-width: 420px;
		padding: 0.8rem 1.5rem;
		background: #0f172a;
		color: #ffffff;
		font-size: 0.92rem;
		font-weight: 700;
		border-radius: 8px;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
		box-sizing: border-box;
	}
	.all-articles-cta-btn:hover {
		background: #1e293b;
		color: #38bdf8;
		transform: translateY(-1px);
		text-decoration: none;
	}

	@media (max-width: 680px) {
		.author-profile-box {
			flex-direction: column;
			text-align: center;
			padding: 1.4rem 1.2rem;
			gap: 1rem;
		}
		.author-meta-row,
		.author-links-row {
			justify-content: center;
		}
		.prev-next-nav {
			grid-template-columns: 1fr;
		}
		.older-card {
			text-align: left;
		}
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
