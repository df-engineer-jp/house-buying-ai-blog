---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p class="copyright">
			&copy; {today.getFullYear()} D.F.Blogger / 『5年後、家を買わされるAIエージェント』. Produced by D.F.Engineer
		</p>
		<div class="footer-links">
			<a href="https://note.com/df_blogger" target="_blank" rel="noopener" class="footer-link">📓 思考休憩所 (note)</a>
			<span class="divider">・</span>
			<a href="https://github.com/df-engineer-jp/house-buying-ai-blog" target="_blank" rel="noopener" class="footer-link">💻 GitHub</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2.5rem 1rem 4rem;
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
		color: #64748b;
		text-align: center;
		font-size: 0.85rem;
	}
	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}
	.copyright {
		margin: 0 0 0.75rem 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
	}
	.footer-link {
		color: #64748b;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-link:hover {
		color: #2563eb;
		text-decoration: underline;
	}
	.divider {
		color: #cbd5e1;
	}
</style>
