---
interface Props {
  status?: 'idle' | 'executing' | 'alert' | 'panic' | 'success' | 'victory' | 'standby' | 'overclock';
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
  earned?: number;
  target?: number;
}

const {
  status: rawStatus = 'idle',
  message,
  width = 180,
  animated = true,
  earned = 0,
  target = 50000000,
} = Astro.props;

// ステータスマッピング (互換性: panic -> alert, victory -> success)
const statusMap: Record<string, 'idle' | 'executing' | 'alert' | 'success' | 'standby' | 'overclock'> = {
  idle: 'idle',
  executing: 'executing',
  alert: 'alert',
  panic: 'alert',
  success: 'success',
  victory: 'success',
  standby: 'standby',
  overclock: 'overclock',
};
const status = statusMap[rawStatus] || 'idle';

// ★ 1. ベースはどの感情でも一貫した「青色ホログラム（シアン・ブルー系統）」
const BASE_THEME = {
  primary: '#0284c7',      // ディープシアン (星コア外側、外周リングなど)
  secondary: '#38bdf8',    // スカイブルー (星コア内側)
  accent: '#0ea5e9',       // オーシャンブルー (七角形枠、中間点線、リング1など)
  text: '#0284c7',         // 通常テレメトリ文字
  void_accent: '#0ea5e9',
  glow: 'rgba(2, 132, 199, 0.40)',
  halo: {
    center: '#e0f2fe',
    light: '#bae6fd',
    mid: '#7dd3fc',
    main: '#38bdf8',
    edge: '#0284c7',
  },
  gauge_bg: '#bae6fd',     // ミニゲージ背景レール
};

// ★ 2. 感情表現（PENのモノリスと完全一致したステータス文字列 ＆ 全文字列の感情色同期）
const EMOTION_CONFIGS = {
  idle: {
    color: '#0284c7',      // 平時はホログラムと同系統のディープシアン
    glow: 'rgba(2, 132, 199, 0.40)',
    mainText: 'ONLINE',
  },
  executing: {
    color: '#059669',      // 実行中エメラルドグリーン
    glow: 'rgba(5, 150, 105, 0.45)',
    mainText: 'RUNNING',
  },
  alert: {
    color: '#ef4444',      // 警告レッド
    glow: 'rgba(239, 68, 68, 0.48)',
    mainText: 'ERR !',
  },
  success: {
    color: '#10b981',      // 成功グリーン
    glow: 'rgba(16, 185, 129, 0.48)',
    mainText: '200 OK ✔',
  },
  standby: {
    color: '#64748b',      // 待機スレートシルバー
    glow: 'rgba(100, 116, 139, 0.25)',
    mainText: 'STANDBY',
  },
  overclock: {
    color: '#d946ef',      // 限界突破ネオンマゼンタ
    glow: 'rgba(217, 70, 239, 0.52)',
    mainText: 'OVERCLOCK',
  },
};

const emotion = EMOTION_CONFIGS[status] || EMOTION_CONFIGS.idle;
const mainStatusText = message || emotion.mainText;
const theme = BASE_THEME;
const target_str = target >= 1000000 ? `¥${(target / 1000000) % 1 === 0 ? (target / 1000000) : (target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earned_str = `¥${earned.toLocaleString()}`;
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);

const cx = 140;
const cy = 140;
// ★ 外枠からしっかり離したモノリス同等18pxフォント配置（r_text=104: 外枠124との間に十分な呼吸感）
const r_text = 104; 
// ★ 文字直下に寄り添うミニゲージ(r_gauge=90)
const r_gauge = 90; 
// ★ コア周りの拡大リング1(r=80)
const r_ring1 = 80;
// ★ 中間点線リング(r=58, 反時計回り, 独立10分割ドット)
const r_inner_dash = 58;

// 幾何学座標の計算 (度数法からデカルト座標)
function polarToCart(r: number, deg: number) {
  const rad = (deg * Math.PI) / 180.0;
  return {
    x: cx + r * Math.cos(rad),
    y: cy + r * Math.sin(rad),
  };
}

// ★ 残金文字列「TARGET: ¥50M [¥0]」の初期幾何学位置（18px r=104 dx=48 実測値 131.9°〜246.6°）
// クライアント側ではさらに <script> により端末実機の getStartPositionOfChar / getEndPositionOfChar でミリ単位自動吸着
const deg1_g = 131.9; // 「TARGET」先頭Tの直下
const deg2_g = 246.6; // 「[¥0]」末尾ブラケット直下

const pt1_g = polarToCart(r_gauge, deg1_g);
const pt2_g = polarToCart(r_gauge, deg2_g);
const gauge_total_arc = r_gauge * (deg2_g - deg1_g) * (Math.PI / 180.0);
const gauge_fill = Math.max(Math.floor(gauge_total_arc * ratio), 4);

const height = width;
const componentId = `nova-orb-${Math.random().toString(36).substring(2, 8)}`;
---

<div 
  class={`nova-core-wrapper status-${status} ${animated ? 'animated' : ''}`}
  data-status={status}
  data-ratio={ratio}
  style={`--theme-color: ${emotion.color}; --theme-accent: ${BASE_THEME.secondary}; --theme-glow: ${emotion.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 280 280" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="nova-core-svg"
  >
    <defs>
      <!-- 1. 中心から均一になだらかに広がるソフトグラデーション（どの感情でも常に青色ホログラム光） -->
      <radialGradient id={`haloLight-${componentId}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color={BASE_THEME.halo.center} stop-opacity="0.75"/>
        <stop offset="30%" stop-color={BASE_THEME.halo.light} stop-opacity="0.55"/>
        <stop offset="60%" stop-color={BASE_THEME.halo.mid} stop-opacity="0.35"/>
        <stop offset="80%" stop-color={BASE_THEME.halo.main} stop-opacity="0.18"/>
        <stop offset="95%" stop-color={BASE_THEME.halo.edge} stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
      </radialGradient>

      <!-- 2. 背景光ソフトぼかしフィルター（blur=6px: 縁をくっきりさせず滑らかにグラデーション化） -->
      <filter id={`bgLightBlur-${componentId}`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6"/>
      </filter>

      <!-- 3. 一連のデータストリーム用360度パス (r=104: 外枠からしっかり離した配置・時計回り) -->
      <path id={`streamPath-${componentId}`} d="M 140,36 A 104,104 0 1,1 139.9,36 Z" fill="none"/>

      <!-- 4. ホログラムソフトグロー -->
      <filter id={`holoGlow-${componentId}`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="0.8" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- 中心から均一に広がるソフトグラデーション背景（どの感情でも常に青色ホログラム光） -->
    <circle cx="140" cy="140" r="120" fill={`url(#haloLight-${componentId})`} filter={`url(#bgLightBlur-${componentId})`}/>

    <!-- 最外周：測位リング（回らない・静止、1.6px、光が透ける0.38透過、pathLength=360で全12ブロック3連ドット完全保証） -->
    <circle cx="140" cy="140" r="124" fill="none" stroke={BASE_THEME.text} stroke-width="1.6" stroke-opacity="0.38" pathLength="360" stroke-dasharray="13 3.5 1.5 2.5 1.5 2.5 1.5 4" class="outer-ring"/>

    <!-- ★ 一緒に回転するデータストリーム＋寄り添いゲージ (r=104, r=90) ★ -->
    <g class="rotating-stream">
      <!-- 一連の稼働データストリーム（感情によって全ての文字列の色が変わる！） -->
      <text font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace" font-size="18" font-weight="bold" fill={emotion.color} fill-opacity="0.95" letter-spacing="1.4">
        <textPath href={`#streamPath-${componentId}`} startOffset="0%">
          <tspan class="status-tspan" font-size="21" font-weight="900">{mainStatusText}</tspan>
          <tspan dx="48">DAEMONS: 5/5</tspan>
          <tspan class="target-tspan" dx="48">TARGET: {target_str} [{earned_str}]</tspan>
        </textPath>
      </text>

      <!-- TARGET直下の寄り添いミニ・アークゲージ (r=90: 文字列と同一の感情色ストリーム) -->
      <path class="gauge-track" d={`M ${pt1_g.x.toFixed(1)},${pt1_g.y.toFixed(1)} A ${r_gauge},${r_gauge} 0 0,1 ${pt2_g.x.toFixed(1)},${pt2_g.y.toFixed(1)}`} 
            fill="none" stroke={BASE_THEME.gauge_bg} stroke-width="1.6" stroke-linecap="round"/>
      <path class="gauge-bar" d={`M ${pt1_g.x.toFixed(1)},${pt1_g.y.toFixed(1)} A ${r_gauge},${r_gauge} 0 0,1 ${pt2_g.x.toFixed(1)},${pt2_g.y.toFixed(1)}`} 
            fill="none" stroke={emotion.color} stroke-width="1.6" stroke-linecap="round"
            stroke-dasharray={`${gauge_fill} 300`} stroke-opacity="0.95"/>
      <circle class="gauge-dot-start" cx={pt1_g.x.toFixed(1)} cy={pt1_g.y.toFixed(1)} r="1.3" fill={emotion.color}/>
      <circle class="gauge-dot-end" cx={pt2_g.x.toFixed(1)} cy={pt2_g.y.toFixed(1)} r="1.3" fill={emotion.color}/>
    </g>

    <!-- ★ コアの周りを立体公転する単一の洗練された惑星リング（リアクションに左右されずホログラム共通色で固定！） ★ -->
    <!-- リング1（-60度傾斜）：r=80へ拡大＆厚み100%維持立体回転 (stroke-width="1.6"、ホログラム色固定) -->
    <g class="jarvis-3d-ring-1">
      <circle class="ring-core-1" cx="140" cy="140" r="80" fill="none" stroke={BASE_THEME.primary} stroke-width="1.6" stroke-opacity="0.95" vector-effect="non-scaling-stroke"/>
    </g>

    <!-- ★ 中間点線リング（r=58）：初期復元案3（r=58 ✕ 初期パターン 8,4,2,4 ✕ 線幅1px、青色ホログラム同系統）★ -->
    <g class="inner-dash-ring">
      <circle cx="140" cy="140" r="58" fill="none" stroke={BASE_THEME.accent} stroke-width="1" stroke-dasharray="8,4,2,4" stroke-opacity="0.85" vector-effect="non-scaling-stroke"/>
    </g>

    <!-- アパーチャ光彩羽根（七角形クリスタルフレーム：ホログラム同系統 #0ea5e9、stroke-width="1.6"） -->
    <polygon points="140,98 166,114 176,144 156,172 124,176 102,150 108,120" fill="none" stroke={BASE_THEME.accent} stroke-width="1.6" stroke-opacity="0.85" vector-effect="non-scaling-stroke"/>

    <!-- ★ NOVA公式決定稿：超新星・八芒星コア（薄さ・蛍光色を脱却し、他のホログラムと完全に系統一致した青色グラデーション） -->
    <g transform="translate(140, 140)">
      <g class="supernova-star">
        <!-- 1. 外側四芒星（上下左右、ディープシアン #0284c7） -->
        <path d="M 0,-34 L 5,-10 L 30,0 L 5,10 L 0,34 L -5,10 L -30,0 L -5,-10 Z" fill={BASE_THEME.primary}/>
        <!-- 2. 内側四芒星（45度回転、スカイブルー #38bdf8） -->
        <path d="M 0,-20 L 3.5,-6 L 18,0 L 3.5,6 L 0,20 L -3.5,6 L -18,0 L -3.5,-6 Z" fill={BASE_THEME.secondary} transform="rotate(45)"/>
        <!-- 3. 中心円（淡い水色ハイライト #bae6fd） -->
        <circle cx="0" cy="0" r="3.8" fill={BASE_THEME.halo.light}/>
      </g>
    </g>
  </svg>
</div>

<style>
  .nova-core-wrapper {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: filter 0.3s ease, transform 0.2s ease;
  }

  .nova-core-wrapper:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 28px var(--theme-glow));
  }

  .nova-core-svg {
    display: block;
    overflow: visible;
  }

  /* 最外周円は静止（回らない） */

  /* 一緒に回転するデータストリーム＋TARGETメーター（時計回り25秒） */
  .animated .rotating-stream {
    animation: rotateClockwise 25s linear infinite;
    transform-origin: 140px 140px;
  }

  /* 親グループで傾斜（-60°）を完全固定 */
  .jarvis-3d-ring-1 {
    transform-origin: 140px 140px;
    transform: rotate(-60deg);
  }

  /* 子の circle で Cosine 余弦波 scaleX（下限0.012 ✕ non-scaling-stroke: 横向き時も厚み100%維持） */
  .animated .ring-core-1 {
    transform-origin: 140px 140px;
    animation: coinSpin1 7s linear infinite;
  }

  /* ★ 中間点線リング：反時計回り公転（18秒周期） ★ */
  .animated .inner-dash-ring {
    animation: rotateCounter 18s linear infinite;
    transform-origin: 140px 140px;
  }

  .animated .supernova-star {
    animation: starPulse 2.8s infinite ease-in-out;
    transform-origin: 0px 0px;
  }

  .animated.status-executing .rotating-stream {
    animation-duration: 8s;
  }

  .animated.status-executing .ring-core-1 {
    animation-duration: 3.5s;
  }

  .animated.status-executing .inner-dash-ring {
    animation-duration: 6s;
  }

  .animated.status-overclock .rotating-stream {
    animation-duration: 4s;
  }

  .animated.status-overclock .ring-core-1 {
    animation-duration: 1.8s;
  }

  .animated.status-overclock .inner-dash-ring {
    animation-duration: 3s;
  }

  @keyframes rotateClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotateCounter {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @keyframes starPulse {
    0%, 100% { transform: scale(1); opacity: 0.95; }
    50% { transform: scale(1.10); opacity: 1; filter: drop-shadow(0 0 6px rgba(2, 132, 199, 0.5)); }
  }

  /* ★ 余弦波（Cosine）コイン立体回転：下限0.012により一直線時でも線幅が絶対に0に潰れず、正面と同じ厚みを維持 ★ */
  @keyframes coinSpin1 {
    0.00% { transform: scaleX(1.0000); }
    4.17% { transform: scaleX(0.9659); }
    8.33% { transform: scaleX(0.8660); }
    12.50% { transform: scaleX(0.7071); }
    16.67% { transform: scaleX(0.5000); }
    20.83% { transform: scaleX(0.2588); }
    25.00% { transform: scaleX(0.0120); }
    29.17% { transform: scaleX(-0.2588); }
    33.33% { transform: scaleX(-0.5000); }
    37.50% { transform: scaleX(-0.7071); }
    41.67% { transform: scaleX(-0.8660); }
    45.83% { transform: scaleX(-0.9659); }
    50.00% { transform: scaleX(-1.0000); }
    54.17% { transform: scaleX(-0.9659); }
    58.33% { transform: scaleX(-0.8660); }
    62.50% { transform: scaleX(-0.7071); }
    66.67% { transform: scaleX(-0.5000); }
    70.83% { transform: scaleX(-0.2588); }
    75.00% { transform: scaleX(-0.0120); }
    79.17% { transform: scaleX(0.2588); }
    83.33% { transform: scaleX(0.5000); }
    87.50% { transform: scaleX(0.7071); }
    91.67% { transform: scaleX(0.8660); }
    95.83% { transform: scaleX(0.9659); }
    100.00% { transform: scaleX(1.0000); }
  }
</style>

<script>
  // ★ 全OS・全ブラウザ（iOS/Mac/Windows/Linux/Android）完全自動同期エンジン ★
  // フォントの字幅メトリクス差異をリアルタイム吸収し、実際の文字位置にミリ単位でピタッと吸着
  function autoAlignNovaGauges() {
    const svgs = document.querySelectorAll('svg.nova-core-svg');
    svgs.forEach((svg) => {
      try {
        const targetTspan = svg.querySelector('.target-tspan') as SVGTSpanElement | null;
        if (!targetTspan) return;
        
        const numChars = targetTspan.getNumberOfChars();
        if (!numChars || numChars === 0) return;
        
        const pt1 = targetTspan.getStartPositionOfChar(0);
        const pt2 = targetTspan.getEndPositionOfChar(numChars - 1);
        
        if (!pt1 || !pt2 || (pt1.x === 0 && pt1.y === 0)) return;
        
        const cx = 140;
        const cy = 140;
        const deg1 = (Math.atan2(pt1.y - cy, pt1.x - cx) * 180 / Math.PI + 360) % 360;
        const deg2 = (Math.atan2(pt2.y - cy, pt2.x - cx) * 180 / Math.PI + 360) % 360;
        
        const r_gauge = 90;
        const rad1 = (deg1 * Math.PI) / 180;
        const rad2 = (deg2 * Math.PI) / 180;
        
        const p1x = (cx + r_gauge * Math.cos(rad1)).toFixed(1);
        const p1y = (cy + r_gauge * Math.sin(rad1)).toFixed(1);
        const p2x = (cx + r_gauge * Math.cos(rad2)).toFixed(1);
        const p2y = (cy + r_gauge * Math.sin(rad2)).toFixed(1);
        
        const newD = `M ${p1x},${p1y} A ${r_gauge},${r_gauge} 0 0,1 ${p2x},${p2y}`;
        
        const track = svg.querySelector('.gauge-track');
        const bar = svg.querySelector('.gauge-bar');
        const dotStart = svg.querySelector('.gauge-dot-start');
        const dotEnd = svg.querySelector('.gauge-dot-end');
        
        if (track) track.setAttribute('d', newD);
        if (bar) {
          bar.setAttribute('d', newD);
          let arcDeg = deg2 - deg1;
          if (arcDeg < 0) arcDeg += 360;
          const totalArc = r_gauge * arcDeg * (Math.PI / 180);
          const ratioAttr = svg.closest('.nova-core-wrapper')?.getAttribute('data-ratio');
          const ratio = ratioAttr ? parseFloat(ratioAttr) : 0;
          const fill = Math.max(Math.floor(totalArc * ratio), 4);
          bar.setAttribute('stroke-dasharray', `${fill} 300`);
        }
        if (dotStart) {
          dotStart.setAttribute('cx', p1x);
          dotStart.setAttribute('cy', p1y);
        }
        if (dotEnd) {
          dotEnd.setAttribute('cx', p2x);
          dotEnd.setAttribute('cy', p2y);
        }
      } catch (err) {
        // SVG getStartPositionOfChar can throw if not attached or rendered yet
      }
    });
  }

  // ライフサイクル全フェーズで確実に同期
  if (typeof window !== 'undefined') {
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(autoAlignNovaGauges);
    }
    window.addEventListener('load', autoAlignNovaGauges);
    requestAnimationFrame(autoAlignNovaGauges);
    setTimeout(autoAlignNovaGauges, 50);
    setTimeout(autoAlignNovaGauges, 200);
    setTimeout(autoAlignNovaGauges, 800);
  }
</script>
