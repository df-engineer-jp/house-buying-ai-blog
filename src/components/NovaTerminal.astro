---
interface Props {
  status?: 'idle' | 'executing' | 'alert' | 'panic' | 'success' | 'victory' | 'standby' | 'overclock';
  message?: string;
  width?: number;
  animated?: boolean;
  earned?: number;
  target?: number;
  interactive?: boolean;
}

const {
  status: rawStatus = 'idle',
  width = 180,
  animated = true,
} = Astro.props;

const statusMap: Record<string, 'idle' | 'executing' | 'alert' | 'success' | 'standby' | 'overclock'> = {
  idle: 'idle',
  executing: 'executing',
  alert: 'alert',
  panic: 'alert',
  success: 'success',
  victory: 'success',
  standby: 'standby',
  overclock: 'overclock',
};
const status = statusMap[rawStatus] || 'idle';

// 内部の星は周りの青（シアン）と同じ色に固定し、感情は中心コア光の色と明滅で表現する
const STAR_COLOR = { core: '#ffffff', glow: '#67e8f9', mid: '#22d3ee' };

const CORE_COLORS: Record<string, { inner: string; mid: string; outer: string }> = {
  idle:      { inner: '#ffffff', mid: '#cffafe', outer: '#22d3ee' },
  executing: { inner: '#ecfdf5', mid: '#6ee7b7', outer: '#10b981' },
  alert:     { inner: '#fff1f2', mid: '#f87171', outer: '#ef4444' },
  success:   { inner: '#f0fdf4', mid: '#4ade80', outer: '#16a34a' },
  standby:   { inner: '#f8fafc', mid: '#cbd5e1', outer: '#64748b' },
  overclock: { inner: '#fdf4ff', mid: '#e879f9', outer: '#c026d3' },
};

const coreColor = CORE_COLORS[status] || CORE_COLORS.idle;
const uid = `nova_${status}_${Math.random().toString(36).slice(2, 9)}`;

// 正八芒星 {8/3} 完全一筆書きパス生成
function buildOctagram83Path(cx: number, cy: number, r: number, rotDeg = -90): string {
  const pts: string[] = [];
  let idx = 0;
  for (let i = 0; i < 8; i++) {
    const ang = ((rotDeg + idx * 45) * Math.PI) / 180.0;
    const x = cx + r * Math.cos(ang);
    const y = cy + r * Math.sin(ang);
    pts.push(`${i === 0 ? 'M' : 'L'} ${x.toFixed(2)},${y.toFixed(2)}`);
    idx = (idx + 3) % 8;
  }
  return pts.join(' ') + ' Z';
}

const pathOuter = buildOctagram83Path(200, 200, 122, -90);
const pathInner = buildOctagram83Path(200, 200, 108, -90);
---

<div
  class={`nova-orb-wrapper status-${status} ${animated ? 'animated' : ''}`}
  data-status={status}
  style={`width: ${width}px; height: ${width}px;`}
>
  <svg
    viewBox="0 0 400 400"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
    class="nova-orb-svg"
    role="img"
    aria-label={`NOVA (${status})`}
  >
    <defs>
      <!-- 外周オーラハロー -->
      <radialGradient id={`${uid}_outer_halo`} cx="50%" cy="50%" r="50%">
        <stop offset="68%" stop-color="#22d3ee" stop-opacity="0.0" />
        <stop offset="76%" stop-color="#38bdf8" stop-opacity="0.48" />
        <stop offset="85%" stop-color="#0ea5e9" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0" />
      </radialGradient>

      <!-- フレネル球体リム -->
      <radialGradient id={`${uid}_fresnel`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#082f49" stop-opacity="0.08" />
        <stop offset="50%" stop-color="#0e7490" stop-opacity="0.24" />
        <stop offset="77%" stop-color="#22d3ee" stop-opacity="0.62" />
        <stop offset="91%" stop-color="#67e8f9" stop-opacity="0.92" />
        <stop offset="96%" stop-color="#ecfeff" stop-opacity="0.94" />
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0.0" />
      </radialGradient>

      <!-- 上部ガラス艶 -->
      <radialGradient id={`${uid}_rim_sheen`} cx="42%" cy="28%" r="52%">
        <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.28" />
        <stop offset="52%" stop-color="#38bdf8" stop-opacity="0.08" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0" />
      </radialGradient>

      <!-- 中央コア光（感情に応じて内部に光を灯す） -->
      <radialGradient id={`${uid}_core_glow`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color={coreColor.inner} stop-opacity="0.96" />
        <stop offset="28%" stop-color={coreColor.mid} stop-opacity="0.72" />
        <stop offset="62%" stop-color={coreColor.outer} stop-opacity="0.28" />
        <stop offset="100%" stop-color={coreColor.outer} stop-opacity="0.0" />
      </radialGradient>

      <!-- オーロラ・プラズマ雲1 -->
      <filter id={`${uid}_plasma1`} x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.017" numOctaves="5" seed="11" result="n1" />
        <feColorMatrix
          type="matrix"
          in="n1"
          values="
            0 0 0 0 0.50
            0 0 0 0 0.92
            0 0 0 0 1.00
            0 0 0 2.2 -0.48"
          result="c1"
        />
        <feComposite in="c1" in2="SourceAlpha" operator="in" />
      </filter>

      <!-- プラズマ雲2 -->
      <filter id={`${uid}_plasma2`} x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.038 0.024" numOctaves="4" seed="42" result="n2" />
        <feColorMatrix
          type="matrix"
          in="n2"
          values="
            0 0 0 0 0.85
            0 0 0 0 0.98
            0 0 0 0 1.00
            0 0 0 1.9 -0.58"
          result="c2"
        />
        <feComposite in="c2" in2="SourceAlpha" operator="in" />
      </filter>

      <!-- リム発光ぼかし -->
      <filter id={`${uid}_rim_blur`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3.2" result="rb1" />
        <feGaussianBlur stdDeviation="8.5" result="rb2" />
        <feMerge>
          <feMergeNode in="rb2" />
          <feMergeNode in="rb1" />
        </feMerge>
      </filter>

      <!-- 星の線発光 -->
      <filter id={`${uid}_star_glow`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.4" result="sb1" />
        <feGaussianBlur stdDeviation="6.5" result="sb2" />
        <feMerge>
          <feMergeNode in="sb2" />
          <feMergeNode in="sb1" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <clipPath id={`${uid}_sphere_clip`}>
        <circle cx="200" cy="200" r="152" />
      </clipPath>

      <radialGradient id={`${uid}_cloud_mask_grad`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.24" />
        <stop offset="45%" stop-color="#ffffff" stop-opacity="0.52" />
        <stop offset="78%" stop-color="#ffffff" stop-opacity="0.94" />
        <stop offset="96%" stop-color="#ffffff" stop-opacity="1.0" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0" />
      </radialGradient>
      <mask id={`${uid}_cloud_mask`}>
        <circle cx="200" cy="200" r="152" fill={`url(#${uid}_cloud_mask_grad)`} />
      </mask>
    </defs>

    <!-- 1. 外周オーラ -->
    <circle cx="200" cy="200" r="196" fill={`url(#${uid}_outer_halo)`} />

    <!-- 2. プラズマ球体内部 -->
    <g clip-path={`url(#${uid}_sphere_clip)`}>
      <circle cx="200" cy="200" r="152" fill="#0c4a6e" fill-opacity="0.68" />
      <g mask={`url(#${uid}_cloud_mask)`}>
        <g class="nova-cloud-layer">
          <circle cx="200" cy="200" r="152" fill="#22d3ee" filter={`url(#${uid}_plasma1)`} opacity="0.95" />
          <circle cx="200" cy="200" r="152" fill="#ecfeff" filter={`url(#${uid}_plasma2)`} opacity="0.72" />
        </g>
      </g>
      <circle cx="200" cy="200" r="152" fill={`url(#${uid}_fresnel)`} />
      <circle cx="200" cy="200" r="152" fill={`url(#${uid}_rim_sheen)`} />
    </g>

    <!-- 3. 球体外周の柔らかい発光膜 -->
    <circle
      cx="200"
      cy="200"
      r="150"
      fill="none"
      stroke="#67e8f9"
      stroke-width="4.5"
      opacity="0.88"
      filter={`url(#${uid}_rim_blur)`}
    />

    <!-- 4. 中央コア光（感情カラー＋アラート時フアンフアン明滅） -->
    <circle class="nova-core-glow" cx="200" cy="200" r="76" fill={`url(#${uid}_core_glow)`} />

    <!-- 5. 一筆書き {8/3} 正八芒星（周りの青と同じシアン固定） -->
    <g class="nova-star-group" filter={`url(#${uid}_star_glow)`} stroke-linejoin="miter" stroke-linecap="round">
      <path d={pathOuter} fill="none" stroke={STAR_COLOR.mid} stroke-width="4.2" opacity="0.78" />
      <path d={pathOuter} fill="none" stroke={STAR_COLOR.glow} stroke-width="2.6" opacity="0.96" />
      <path d={pathInner} fill="none" stroke={STAR_COLOR.glow} stroke-width="1.8" opacity="0.90" />
      <path d={pathOuter} fill="none" stroke={STAR_COLOR.core} stroke-width="1.25" opacity="0.98" />
      <path d={pathInner} fill="none" stroke={STAR_COLOR.core} stroke-width="0.85" opacity="0.94" />
    </g>
  </svg>
</div>

<style>
  .nova-orb-wrapper {
    display: inline-block;
    user-select: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .nova-orb-wrapper:hover {
    transform: scale(1.05);
  }
  .nova-orb-svg {
    display: block;
    overflow: visible;
  }

  .nova-orb-wrapper.animated .nova-star-group {
    transform-origin: 200px 200px;
    animation: novaStarBreath 3.6s ease-in-out infinite;
  }
  .nova-orb-wrapper.animated .nova-cloud-layer {
    transform-origin: 200px 200px;
    animation: novaCloudDrift 9s ease-in-out infinite;
  }

  .status-executing.animated .nova-star-group {
    animation-duration: 1.8s;
  }
  .status-alert.animated .nova-star-group {
    animation-duration: 1.4s;
  }
  .status-alert.animated .nova-core-glow {
    transform-origin: 200px 200px;
    animation: novaCoreAlertPulse 1.5s ease-in-out infinite;
  }
  .status-overclock.animated .nova-star-group {
    animation-duration: 1.4s;
  }

  @keyframes novaCoreAlertPulse {
    0%, 100% {
      transform: scale(0.84);
      opacity: 0.32;
    }
    50% {
      transform: scale(1.16);
      opacity: 1;
    }
  }

  @keyframes novaStarBreath {
    0%, 100% {
      transform: scale(1);
      opacity: 0.94;
    }
    50% {
      transform: scale(1.03);
      opacity: 1;
    }
  }

  @keyframes novaCloudDrift {
    0%, 100% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(8deg) scale(1.03);
    }
  }
</style>
