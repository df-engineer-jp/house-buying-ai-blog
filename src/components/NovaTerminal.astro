---
interface Props {
  status?: 'idle' | 'executing' | 'alert' | 'panic' | 'success' | 'victory' | 'standby' | 'overclock';
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
  earned?: number;
  target?: number;
}

const {
  status: rawStatus = 'idle',
  message,
  width = 180,
  animated = true,
  earned = 0,
  target = 50000000,
} = Astro.props;

// ステータスマッピング (互換性: panic -> alert, victory -> success)
const statusMap: Record<string, 'idle' | 'executing' | 'alert' | 'success' | 'standby' | 'overclock'> = {
  idle: 'idle',
  executing: 'executing',
  alert: 'alert',
  panic: 'alert',
  success: 'success',
  victory: 'success',
  standby: 'standby',
  overclock: 'overclock',
};
const status = statusMap[rawStatus] || 'idle';

const COLOR_THEMES = {
  idle: {
    primary: '#f0883e',
    secondary: '#fb923c',
    text: '#c2410c',
    void_accent: '#ea580c',
    glow: 'rgba(240, 136, 62, 0.45)',
    halo: {
      center: '#ffedd5',
      light: '#fed7aa',
      mid: '#fdba74',
      main: '#fb923c',
      edge: '#f97316',
    },
    gauge_bg: '#fed7aa',
  },
  executing: {
    primary: '#10b981',
    secondary: '#34d399',
    text: '#047857',
    void_accent: '#059669',
    glow: 'rgba(16, 185, 129, 0.45)',
    halo: {
      center: '#d1fae5',
      light: '#a7f3d0',
      mid: '#6ee7b7',
      main: '#34d399',
      edge: '#10b981',
    },
    gauge_bg: '#a7f3d0',
  },
  alert: {
    primary: '#ef4444',
    secondary: '#f87171',
    text: '#b91c1c',
    void_accent: '#dc2626',
    glow: 'rgba(239, 68, 68, 0.48)',
    halo: {
      center: '#fee2e2',
      light: '#fecaca',
      mid: '#fca5a5',
      main: '#f87171',
      edge: '#ef4444',
    },
    gauge_bg: '#fecaca',
  },
  success: {
    primary: '#00ff9d',
    secondary: '#4ade80',
    text: '#15803d',
    void_accent: '#16a34a',
    glow: 'rgba(0, 255, 157, 0.48)',
    halo: {
      center: '#dcfce7',
      light: '#bbf7d0',
      mid: '#86efac',
      main: '#4ade80',
      edge: '#22c55e',
    },
    gauge_bg: '#bbf7d0',
  },
  standby: {
    primary: '#94a3b8',
    secondary: '#64748b',
    text: '#475569',
    void_accent: '#334155',
    glow: 'rgba(148, 163, 184, 0.25)',
    halo: {
      center: '#f1f5f9',
      light: '#e2e8f0',
      mid: '#cbd5e1',
      main: '#94a3b8',
      edge: '#64748b',
    },
    gauge_bg: '#e2e8f0',
  },
  overclock: {
    primary: '#d946ef',
    secondary: '#e879f9',
    text: '#a21caf',
    void_accent: '#c026d3',
    glow: 'rgba(217, 70, 239, 0.52)',
    halo: {
      center: '#fae8ff',
      light: '#f5d0fe',
      mid: '#f0abfc',
      main: '#e879f9',
      edge: '#d946ef',
    },
    gauge_bg: '#f5d0fe',
  },
};

const theme = COLOR_THEMES[status] || COLOR_THEMES.idle;
const target_str = target >= 1000000 ? `¥${(target / 1000000).toFixed(1)}M` : `¥${target.toLocaleString()}`;
const earned_str = `¥${earned.toLocaleString()}`;
const ratio = Math.min(Math.max(earned / target, 0.0), 1.0);

const cx = 140;
const cy = 140;
const r_telemetry = 112; // 最外周(124)の直下を周回するテレメトリリング
const r_target = 98;      // TARGETテキスト (下部中央固定)
const r_gauge = 88;       // 寄り添いミニゲージ (下部中央固定)

// 幾何学座標の計算 (度数法からデカルト座標)
function polarToCart(r: number, deg: number) {
  const rad = (deg * Math.PI) / 180.0;
  return {
    x: cx + r * Math.cos(rad),
    y: cy + r * Math.sin(rad),
  };
}

// 1. 下部固定TARGETテキスト用パス (130度〜50度, 反時計回り sweep=0)
const pt1_t = polarToCart(r_target, 130);
const pt2_t = polarToCart(r_target, 50);

// 2. 下部固定寄り添いゲージ用パス (124度〜56度 = 68度)
const pt1_g = polarToCart(r_gauge, 124);
const pt2_g = polarToCart(r_gauge, 56);
const gauge_total_arc = 2 * Math.PI * r_gauge * (68.0 / 360.0); // ≈ 104.4px
const gauge_fill = Math.max(Math.floor(gauge_total_arc * ratio), 4);

const height = width;
const componentId = `nova-orb-${Math.random().toString(36).substring(2, 8)}`;
---

<div 
  class={`nova-core-wrapper status-${status} ${animated ? 'animated' : ''}`}
  data-status={status}
  style={`--theme-color: ${theme.primary}; --theme-accent: ${theme.secondary}; --theme-glow: ${theme.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 280 280" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="nova-core-svg"
  >
    <defs>
      <!-- 1. 中心から均一になだらかに広がるソフトグラデーション（ステータスカラー完全連動・中抜け白抜けなし） -->
      <radialGradient id={`haloLight-${componentId}`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color={theme.halo.center} stop-opacity="0.75"/>
        <stop offset="30%" stop-color={theme.halo.light} stop-opacity="0.55"/>
        <stop offset="60%" stop-color={theme.halo.mid} stop-opacity="0.35"/>
        <stop offset="80%" stop-color={theme.halo.main} stop-opacity="0.18"/>
        <stop offset="95%" stop-color={theme.halo.edge} stop-opacity="0.05"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
      </radialGradient>

      <!-- 2. 背景光ソフトぼかしフィルター（blur=6px: 縁をくっきりさせず滑らかにグラデーション化） -->
      <filter id={`bgLightBlur-${componentId}`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6"/>
      </filter>

      <!-- 3. 最外周直下を360度周回するテレメトリテキストパス (r=112) -->
      <path id={`telemetryCircle-${componentId}`} d="M 140,28 A 112,112 0 1,1 139.9,28 Z" fill="none"/>

      <!-- 4. 下部TARGET専用固定テキストパス (r=98) -->
      <path id={`targetPath-${componentId}`} d={`M ${pt1_t.x.toFixed(1)},${pt1_t.y.toFixed(1)} A ${r_target},${r_target} 0 0,0 ${pt2_t.x.toFixed(1)},${pt2_t.y.toFixed(1)}`} fill="none"/>

      <!-- 5. ホログラムソフトグロー -->
      <filter id={`holoGlow-${componentId}`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="0.8" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- 中心から均一に広がるソフトグラデーション背景（r=120, blur=6px: 最外枠124ぴったり内側で滑らかにフェードアウト） -->
    <circle cx="140" cy="140" r="120" fill={`url(#haloLight-${componentId})`} filter={`url(#bgLightBlur-${componentId})`}/>

    <!-- 最外周：測位リング（回らない・静止） -->
    <circle cx="140" cy="140" r="124" fill="none" stroke={theme.text} stroke-width="1.3" stroke-opacity="0.85" stroke-dasharray="45,15,5,15" class="outer-ring"/>
    <circle cx="140" cy="140" r="128" fill="none" stroke={theme.secondary} stroke-width="0.8" stroke-opacity="0.7" stroke-dasharray="2,6"/>

    <!-- ★ 最外周の直下を回転するテレメトリ文字列リング (r=112, 時計回りに周回) -->
    <g class="rotating-telemetry">
      <text font-family="monospace" font-size="5.8" font-weight="bold" fill={theme.text} fill-opacity="0.95" letter-spacing="1.1">
        <textPath href={`#telemetryCircle-${componentId}`} startOffset="0%">
          ROOT PRIVILEGE: FULL ACCESS   DAEMONS: 5/5 ACTIVE   LAT: 26.21°N   LON: 127.68°E
        </textPath>
      </text>
    </g>

    <!-- ガイドライン (r=105) -->
    <circle cx="140" cy="140" r="105" fill="none" stroke={theme.text} stroke-width="0.7" stroke-opacity="0.35" stroke-dasharray="16,8"/>

    <!-- ★ 下部固定 TARGETテキスト (r=98: 回転するテレメトリと絶対に重ならない) -->
    <text font-family="monospace" font-size="6.0" font-weight="bold" fill={theme.text} fill-opacity="0.98" letter-spacing="1.1">
      <textPath href={`#targetPath-${componentId}`} startOffset="50%" text-anchor="middle">
        TARGET: {target_str} [EARNED: {earned_str}]
      </textPath>
    </text>

    <!-- ★ 下部固定 寄り添いミニ・アークゲージ (r=88) -->
    <path d={`M ${pt1_g.x.toFixed(1)},${pt1_g.y.toFixed(1)} A ${r_gauge},${r_gauge} 0 0,0 ${pt2_g.x.toFixed(1)},${pt2_g.y.toFixed(1)}`} 
          fill="none" stroke={theme.gauge_bg} stroke-width="2.2" stroke-linecap="round"/>
    <path d={`M ${pt1_g.x.toFixed(1)},${pt1_g.y.toFixed(1)} A ${r_gauge},${r_gauge} 0 0,0 ${pt2_g.x.toFixed(1)},${pt2_g.y.toFixed(1)}`} 
          fill="none" stroke={theme.text} stroke-width="2.2" stroke-linecap="round"
          stroke-dasharray={`${gauge_fill} 300`} stroke-opacity="0.95"/>
    <circle cx={pt1_g.x.toFixed(1)} cy={pt1_g.y.toFixed(1)} r="1.3" fill={theme.text}/>
    <circle cx="140" cy={cy + r_gauge} r="1.1" fill={theme.void_accent}/>
    <circle cx={pt2_g.x.toFixed(1)} cy={pt2_g.y.toFixed(1)} r="1.3" fill={theme.text}/>

    <!-- JARVIS 脈動球体波形レイヤー -->
    <ellipse cx="140" cy="140" rx="82" ry="26" fill="none" stroke={theme.primary} stroke-width="1.4" stroke-opacity="0.85" transform="rotate(-20 140 140)" class="jarvis-ellipse-1"/>
    <ellipse cx="140" cy="140" rx="82" ry="26" fill="none" stroke="#ffffff" stroke-width="1.1" stroke-dasharray="6,4" stroke-opacity="0.9" transform="rotate(20 140 140)" class="jarvis-ellipse-2"/>

    <!-- 内周高周波リング -->
    <circle cx="140" cy="140" r="68" fill="none" stroke={theme.text} stroke-width="1.1" stroke-opacity="0.85" stroke-dasharray="8,4,2,4" class="inner-ring"/>

    <!-- ★ NOVA ロゴ：黒枠なし、純粋発光、y=61 -->
    <text x="140" y="61" fill={theme.text} font-size="12" font-family="monospace" font-weight="bold" 
          text-anchor="middle" letter-spacing="3.2" filter={`url(#holoGlow-${componentId})`}>NOVA</text>

    <!-- アパーチャ光彩羽根（七角形クリスタルフレーム：公式決定稿完全一致） -->
    <polygon points="140,98 166,114 176,144 156,172 124,176 102,150 108,120" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-opacity="0.95"/>

    <!-- ★ NOVA公式決定稿：超新星・八芒星コア（四芒星を二つ重ねた八芒星） -->
    <g transform="translate(140, 140)">
      <g class="supernova-star">
        <!-- 1. 外側四芒星（上下左右、theme.primary） -->
        <path d="M 0,-34 L 5,-10 L 30,0 L 5,10 L 0,34 L -5,10 L -30,0 L -5,-10 Z" fill={theme.primary}/>
        <!-- 2. 内側四芒星（45度回転、純白 #ffffff） -->
        <path d="M 0,-20 L 3.5,-6 L 18,0 L 3.5,6 L 0,20 L -3.5,6 L -18,0 L -3.5,-6 Z" fill="#ffffff" transform="rotate(45)"/>
        <!-- 3. 中心円（純白 #ffffff） -->
        <circle cx="0" cy="0" r="4.2" fill="#ffffff"/>
      </g>
    </g>
  </svg>
</div>

<style>
  .nova-core-wrapper {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: filter 0.3s ease, transform 0.2s ease;
  }

  .nova-core-wrapper:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 28px var(--theme-glow));
  }

  .nova-core-svg {
    display: block;
    overflow: visible;
  }

  /* 最外周円は静止（回らない） */

  /* 最外周の直下にあるテレメトリ文字列が時計回りに回転 */
  .animated .rotating-telemetry {
    animation: rotateClockwise 25s linear infinite;
    transform-origin: 140px 140px;
  }

  .animated .inner-ring {
    animation: rotateCounter 12s linear infinite;
    transform-origin: 140px 140px;
  }

  .animated .supernova-star {
    animation: starPulse 2.8s infinite ease-in-out;
    transform-origin: 0px 0px;
  }

  .animated.status-executing .rotating-telemetry {
    animation-duration: 8s;
  }

  .animated.status-overclock .rotating-telemetry {
    animation-duration: 4s;
  }

  .animated.status-executing .inner-ring {
    animation-duration: 4s;
  }

  .animated.status-overclock .inner-ring {
    animation-duration: 2s;
  }

  @keyframes rotateClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes rotateCounter {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @keyframes starPulse {
    0%, 100% { transform: scale(1); opacity: 0.95; }
    50% { transform: scale(1.12); opacity: 1; filter: drop-shadow(0 0 6px var(--theme-color)); }
  }
</style>
