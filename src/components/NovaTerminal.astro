    42.5% { transform: perspective(1000px) rotateX(29.0deg) rotateY(-12.1deg) rotateZ(-157.0deg); }
    45.0% { transform: perspective(1000px) rotateX(30.7deg) rotateY(-18.8deg) rotateZ(-157.6deg); }
    47.5% { transform: perspective(1000px) rotateX(38.7deg) rotateY(-24.0deg) rotateZ(-162.6deg); }
    50.0% { transform: perspective(1000px) rotateX(50.7deg) rotateY(-27.4deg) rotateZ(-172.3deg); }
    52.5% { transform: perspective(1000px) rotateX(61.8deg) rotateY(-29.0deg) rotateZ(-185.2deg); }
    55.0% { transform: perspective(1000px) rotateX(66.9deg) rotateY(-28.7deg) rotateZ(-199.0deg); }
    57.5% { transform: perspective(1000px) rotateX(62.9deg) rotateY(-26.0deg) rotateZ(-211.3deg); }
