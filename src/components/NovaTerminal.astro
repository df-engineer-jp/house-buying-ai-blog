    0.0% { transform: perspective(1000px) rotateX(-0.2deg) rotateY(3.7deg) rotateZ(-3.7deg); }
    2.5% { transform: perspective(1000px) rotateX(-3.0deg) rotateY(-10.7deg) rotateZ(-18.2deg); }
