---
interface Props {
  status?: 'idle' | 'executing' | 'alert' | 'success' | 'standby' | 'overclock';
  message?: string;
  width?: number; // 表示幅 (px)
  animated?: boolean;
}

const {
  status = 'idle',
  message,
  width = 240,
  animated = true,
} = Astro.props;

const configs = {
  idle: {
    color: '#00f0ff',
    glow: 'rgba(0, 240, 255, 0.25)',
    chassisBg: '#0b0f17',
    chassisBorder: '#1e293b',
    mainText: '$ nova status',
    metric1: 'SYS: 2vCPU / 8GB',
    metric2: 'DAEMONS: 5 ACTIVE',
    loadPercent: 24,
    defaultPolyline: '58,115 75,115 80,108 85,122 90,111 95,117 100,115 138,115',
    subMsg1: 'LOAD: 0.14 0.08',
    subMsg2: 'QUEUE: 0 PENDING',
  },
  executing: {
    color: '#10b981',
    glow: 'rgba(16, 185, 129, 0.28)',
    chassisBg: '#091613',
    chassisBorder: '#10b981',
    mainText: '> DISPATCHING...',
    metric1: 'TASK: FREELANCE SYNC',
    metric2: 'RUNNING: PLAYWRIGHT',
    loadPercent: 78,
    defaultPolyline: '58,115 68,115 72,102 76,126 80,98 84,128 88,105 92,120 96,115 138,115',
    subMsg1: 'CROWDWORKS: ACTIVE',
    subMsg2: 'AUTONOMOUS REPLY_',
  },
  alert: {
    color: '#ef4444',
    glow: 'rgba(239, 68, 68, 0.35)',
    chassisBg: '#1c0d0f',
    chassisBorder: '#ef4444',
    mainText: '[!] CRITICAL ALERT',
    metric1: 'OVERHEAT / TIMEOUT',
    metric2: 'EXIT: CODE 137',
    loadPercent: 98,
    defaultPolyline: '58,115 65,125 72,95 80,132 88,90 96,135 104,92 112,128 120,105 138,115',
    subMsg1: 'WATCHDOG TRIGGERED',
    subMsg2: '> RECOVERING IN 5s...',
  },
  success: {
    color: '#00ff9d',
    glow: 'rgba(0, 255, 157, 0.3)',
    chassisBg: '#091913',
    chassisBorder: '#00ff9d',
    mainText: '✔ MISSION DONE',
    metric1: 'DEPLOY: 100% LIVE',
    metric2: 'STATUS: HTTP 200',
    loadPercent: 45,
    defaultPolyline: '58,115 75,115 80,100 85,130 92,102 98,115 105,115 138,115',
    subMsg1: 'JOB PROCESSED',
    subMsg2: 'ALL SCRIPTS PASSED',
  },
  standby: {
    color: '#64748b',
    glow: 'rgba(100, 116, 139, 0.15)',
    chassisBg: '#0b0f17',
    chassisBorder: '#1e293b',
    mainText: '......',
    metric1: 'INPUT: UNEXPECTED',
    metric2: 'MODE: SILENT LISTEN',
    loadPercent: 6,
    defaultPolyline: '58,115 138,115',
    subMsg1: '(speechless)',
    subMsg2: '...承知しました。',
  },
  overclock: {
    color: '#d946ef',
    glow: 'rgba(217, 70, 239, 0.38)',
    chassisBg: '#190b1c',
    chassisBorder: '#d946ef',
    mainText: '⚡ OVERCLOCK ⚡',
    metric1: 'ROOT PRIVILEGE: FULL',
    metric2: 'BURST MODE: 100%',
    loadPercent: 100,
    defaultPolyline: '58,110 66,92 74,136 82,88 90,140 98,84 106,142 114,90 122,130 138,110',
    subMsg1: 'CPU: 100% TURBO',
    subMsg2: 'SYSTEM LIMIT REMOVED',
  },
};

const cfg = configs[status] || configs.idle;
const mainText = message || cfg.mainText;
const barWidth = Math.max(Math.floor((cfg.loadPercent / 100) * 80), 2);
const height = Math.round(width * 1.15);
---

<div 
  class={`nova-terminal-wrapper status-${status} ${animated ? 'animated' : ''}`}
  data-status={status}
  style={`--theme-color: ${cfg.color}; --theme-glow: ${cfg.glow}; width: ${width}px; height: ${height}px;`}
>
  <svg 
    viewBox="0 0 200 230" 
    width="100%" 
    height="100%" 
    xmlns="http://www.w3.org/2000/svg"
    class="nova-terminal-svg"
  >
    <!-- 放熱スリット -->
    { [65, 78, 91, 104, 117, 130].map(y => (
      <rect x="33" y={y} width="5" height="7" rx="1.5" fill="#1e293b" stroke="#334155" stroke-width="0.8"/>
      <rect x="162" y={y} width="5" height="7" rx="1.5" fill="#1e293b" stroke="#334155" stroke-width="0.8"/>
    )) }

    <!-- シャーシ外殻 -->
    <rect 
      x="40" 
      y="20" 
      width="120" 
      height="180" 
      rx="6" 
      fill={cfg.chassisBg} 
      stroke={cfg.chassisBorder} 
      stroke-width="2"
      class="nova-chassis"
    />

    <!-- 四隅チタンヘックスボルト -->
    { [
      {cx: 48, cy: 28},
      {cx: 152, cy: 28},
      {cx: 48, cy: 192},
      {cx: 152, cy: 192}
    ].map(b => (
      <g>
        <circle cx={b.cx} cy={b.cy} r="3.2" fill="#1e293b" stroke="#475569" stroke-width="0.8"/>
        <polygon points={`${b.cx},${b.cy-1.5} ${b.cx+1.3},${b.cy-0.75} ${b.cx+1.3},${b.cy+0.75} ${b.cx},${b.cy+1.5} ${b.cx-1.3},${b.cy+0.75} ${b.cx-1.3},${b.cy-0.75}`} fill="#334155"/>
      </g>
    )) }

    <!-- 天板新星（八芒星）レーザー刻印 -->
    <line x1="72" y1="28" x2="88" y2="28" stroke="#334155" stroke-width="1"/>
    <path 
      d="M 100,21 L 102.2,25.8 L 107,28 L 102.2,30.2 L 100,35 L 97.8,30.2 L 93,28 L 97.8,25.8 Z" 
      fill={cfg.color}
      class="nova-star"
    />
    <circle cx="100" cy="28" r="0.8" fill="#ffffff"/>
    <line x1="112" y1="28" x2="128" y2="28" stroke="#334155" stroke-width="1"/>

    <!-- コンソール画面 -->
    <rect 
      x="52" 
      y="42" 
      width="96" 
      height="120" 
      rx="3" 
      fill="#030712" 
      stroke={cfg.color} 
      stroke-width="1.3"
      class="nova-screen"
    />

    <!-- テキストメトリクス -->
    <text x="60" y="58" fill={cfg.color} font-size="7.5" font-family="monospace" font-weight="bold">{mainText}</text>
    <text x="60" y="72" fill="#94a3b8" font-size="7" font-family="monospace">{cfg.metric1}</text>
    <text x="60" y="84" fill={cfg.color} font-size="8" font-family="monospace" font-weight="bold">{cfg.metric2}</text>

    <!-- 負荷バー -->
    <rect x="60" y="92" width="80" height="4" rx="1" fill="#1e293b"/>
    <rect x="60" y="92" width={barWidth} height="4" rx="1" fill={cfg.color} class="nova-load-bar"/>

    <!-- 心電図・オシロスコープ波形 -->
    {status === 'standby' ? (
      <g>
        <line x1="58" y1="115" x2="138" y2="115" stroke="#334155" stroke-width="1.2" stroke-dasharray="2,2"/>
        <text x="98" y="105" fill="#64748b" font-size="16" font-family="monospace" text-anchor="middle">_</text>
        <text x="98" y="135" fill="#64748b" font-size="7.5" font-family="monospace" text-anchor="middle">{cfg.subMsg1}</text>
        <text x="98" y="148" fill="#475569" font-size="7" font-family="monospace" text-anchor="middle">{cfg.subMsg2}</text>
      </g>
    ) : (
      <g>
        <polyline 
          points={cfg.defaultPolyline} 
          fill="none" 
          stroke={cfg.color} 
          stroke-width="1.6" 
          stroke-linecap="round" 
          stroke-linejoin="round"
          class="nova-wave"
        />
        <text x="60" y="135" fill={cfg.color} font-size="7" font-family="monospace">{cfg.subMsg1}</text>
        <text x="60" y="148" fill="#f8fafc" font-size="6.8" font-family="monospace">{cfg.subMsg2}</text>
      </g>
    )}

    <!-- ラックマウントベース台座 -->
    <rect x="26" y="200" width="148" height="8" rx="2" fill="#0f172a" stroke={cfg.chassisBorder} stroke-width="1.5"/>
    <line x1="34" y1="204" x2="166" y2="204" stroke="#1e293b" stroke-width="1.5"/>
  </svg>
</div>

<style>
  .nova-terminal-wrapper {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 0 16px var(--theme-glow));
    transition: filter 0.3s ease, transform 0.2s ease;
  }

  .nova-terminal-wrapper:hover {
    transform: scale(1.02);
    filter: drop-shadow(0 0 24px var(--theme-glow));
  }

  .nova-terminal-svg {
    display: block;
    overflow: visible;
  }

  .animated .nova-star {
    animation: starPulse 2.5s infinite ease-in-out;
    transform-origin: 100px 28px;
  }

  @keyframes starPulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); filter: drop-shadow(0 0 3px var(--theme-color)); }
  }

  .animated.status-executing .nova-wave,
  .animated.status-overclock .nova-wave {
    stroke-dasharray: 4, 2;
    animation: waveFlow 1s linear infinite;
  }

  @keyframes waveFlow {
    from { stroke-dashoffset: 24; }
    to { stroke-dashoffset: 0; }
  }
</style>
