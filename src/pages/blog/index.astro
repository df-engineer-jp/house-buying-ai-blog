---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import MainVisual from '../../components/MainVisual.astro';
import SiteIcon from '../../components/SiteIcon.astro';
import EcosystemShowcase from '../../components/EcosystemShowcase.astro';
import { FILTER_CATEGORIES, resolveCategory, resolveTags } from '../../utils/postMeta';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const catCounts: Record<string, number> = {};
const tagCounts: Record<string, number> = {};

const enrichedPosts = posts.map((post) => {
	const cat = resolveCategory(post.data.category, post.data.title, post.data.description);
	const tags = resolveTags(post.data.tags, post.data.title, post.data.description);
	catCounts[cat.key] = (catCounts[cat.key] || 0) + 1;
	for (const t of tags) {
		tagCounts[t] = (tagCounts[t] || 0) + 1;
	}
	return { post, cat, tags };
});

const popularTags = Object.entries(tagCounts)
	.sort((a, b) => b[1] - a[1])
	.slice(0, 14)
	.map(([tag]) => tag);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8196406764389764" crossorigin="anonymous"></script>
	</head>
	<body class="open-canvas-body">
		<Header />

		<!-- フルワイド（100vw）サブページ用メインビジュアル -->
		<MainVisual
			variant="sub"
			eyebrow="ARTICLES & VERIFIED CODE"
			title="検証記事・突破ログ一覧"
			lead={`6体のAIエージェントと開発者が現場で踏み抜いたエラー・自動化の全記録（現在 ${posts.length} 本公開中）`}
		/>

		<main class="open-main">
			<section class="articles-band">
				<div class="wide-container">
					<!-- 開放感のあるフラットなカテゴリ＆タグ絞り込みバー -->
					<div class="filter-bar" aria-label="記事のカテゴリ・タグ絞り込み">
						<div class="cat-tabs" id="cat-tabs">
							<button type="button" class="cat-tab is-active" data-cat="">
								すべて ({posts.length})
							</button>
							{FILTER_CATEGORIES.map((c) => (
								<button type="button" class="cat-tab" data-cat={c.key}>
									{c.shortLabel} ({catCounts[c.key] || 0})
								</button>
							))}
						</div>

						<div class="tag-filter-row" id="tag-list">
							<span class="tag-filter-label"><SiteIcon name="tag" /> 人気タグ:</span>
							{popularTags.map((t) => (
								<button type="button" class="tag-btn" data-tag={t}>
									#{t}
								</button>
							))}
						</div>

						<div class="active-filter-status" id="filter-status">
							<span id="filter-status-text"></span>
							<button type="button" class="reset-filter-btn" id="reset-filter-btn">絞り込みを解除 ×</button>
						</div>
					</div>

					<!-- 1200px 3カラム・ワイド記事グリッド -->
					<ul class="posts-grid" id="posts-grid">
						{enrichedPosts.map(({ post, cat, tags }) => (
							<li
								class="post-item"
								data-cat={cat.key}
								data-tags={tags.join('|')}
							>
								<a href={`/blog/${post.id}/`} class="post-card-link">
									{post.data.heroImage && (
										<div class="post-img-wrap">
											<Image width={720} height={380} src={post.data.heroImage} alt="" />
											<span class="card-cat-badge">{cat.shortLabel}</span>
										</div>
									)}
									<div class="post-content">
										<span class="date"><FormattedDate date={post.data.pubDate} /></span>
										<h2 class="title">{post.data.title}</h2>
										{post.data.description && (
											<p class="description">{post.data.description}</p>
										)}
										<div class="card-tags">
											{tags.slice(0, 4).map((t) => (
												<span class="card-tag">#{t}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- 下部制作物＆外部メディア導線（ソフト背景バンド） -->
			<section class="ecosystem-band">
				<div class="wide-container">
					<EcosystemShowcase showProducts={true} showMedia={true} />
				</div>
			</section>
		</main>

		<Footer />

		<script is:inline>
			(() => {
				const items = Array.from(document.querySelectorAll('.post-item'));
				const catBtns = Array.from(document.querySelectorAll('.cat-tab'));
				const tagListEl = document.getElementById('tag-list');
				const statusBox = document.getElementById('filter-status');
				const statusText = document.getElementById('filter-status-text');
				const resetBtn = document.getElementById('reset-filter-btn');

				let activeCat = '';
				let activeTag = '';

				function ensureTagButton(tag) {
					if (!tag || !tagListEl) return;
					const existing = Array.from(tagListEl.querySelectorAll('.tag-btn')).find(
						(b) => b.getAttribute('data-tag') === tag
					);
					if (!existing) {
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'tag-btn';
						btn.setAttribute('data-tag', tag);
						btn.textContent = `#${tag}`;
						btn.addEventListener('click', () => {
							activeTag = activeTag === tag ? '' : tag;
							syncUrlAndRender();
						});
						tagListEl.appendChild(btn);
					}
				}

				function renderFilter() {
					let visibleCount = 0;
					items.forEach((li) => {
						const liCat = li.getAttribute('data-cat') || '';
						const liTags = (li.getAttribute('data-tags') || '').split('|');
						const okCat = !activeCat || liCat === activeCat;
						const okTag = !activeTag || liTags.includes(activeTag);
						if (okCat && okTag) {
							li.classList.remove('is-hidden');
							visibleCount++;
						} else {
							li.classList.add('is-hidden');
						}
					});

					catBtns.forEach((b) => {
						b.classList.toggle('is-active', (b.getAttribute('data-cat') || '') === activeCat);
					});
					Array.from(document.querySelectorAll('.tag-btn')).forEach((b) => {
						b.classList.toggle('is-active', (b.getAttribute('data-tag') || '') === activeTag);
					});

					if (statusBox && statusText) {
						if (activeCat || activeTag) {
							statusBox.classList.add('is-visible');
							const parts = [];
							if (activeCat) {
								const activeBtn = catBtns.find((b) => b.getAttribute('data-cat') === activeCat);
								parts.push(`カテゴリ: ${(activeBtn ? activeBtn.textContent : activeCat).replace(/\(\d+\)/, '').trim()}`);
							}
							if (activeTag) parts.push(`タグ: #${activeTag}`);
							statusText.textContent = `${parts.join(' / ')} — 該当 ${visibleCount} 件`;
						} else {
							statusBox.classList.remove('is-visible');
						}
					}
				}

				function syncUrlAndRender() {
					const url = new URL(window.location.href);
					if (activeCat) url.searchParams.set('cat', activeCat);
					else url.searchParams.delete('cat');
					if (activeTag) url.searchParams.set('tag', activeTag);
					else url.searchParams.delete('tag');
					window.history.replaceState({}, '', url.toString());
					renderFilter();
				}

				catBtns.forEach((btn) => {
					btn.addEventListener('click', () => {
						activeCat = btn.getAttribute('data-cat') || '';
						syncUrlAndRender();
					});
				});

				Array.from(document.querySelectorAll('.tag-btn')).forEach((btn) => {
					btn.addEventListener('click', () => {
						const t = btn.getAttribute('data-tag') || '';
						activeTag = activeTag === t ? '' : t;
						syncUrlAndRender();
					});
				});

				if (resetBtn) {
					resetBtn.addEventListener('click', () => {
						activeCat = '';
						activeTag = '';
						syncUrlAndRender();
					});
				}

				const initParams = new URLSearchParams(window.location.search);
				activeCat = initParams.get('cat') || '';
				activeTag = initParams.get('tag') || '';
				if (activeTag) ensureTagButton(activeTag);
				renderFilter();
			})();
		</script>
	</body>
</html>

<style>
	.open-canvas-body {
		background-color: #ffffff;
	}
	.open-main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		background: transparent;
		box-shadow: none;
		border-radius: 0;
	}
	.open-canvas-body :global(footer) {
		margin-top: 0;
	}

	.wide-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2.5rem;
	}
	.articles-band {
		padding: 3.5rem 0 5.5rem;
		background-color: #ffffff;
	}
	.ecosystem-band {
		padding: 1.5rem 0 4rem;
		background-color: #f8fafc;
		border-top: 1px solid #eef2f6;
	}

	/* フラットで抜け感のある絞り込みバー */
	.filter-bar {
		padding-bottom: 1.85rem;
		margin-bottom: 2.75rem;
		border-bottom: 1px solid #e2e8f0;
	}
	.cat-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1rem;
	}
	.cat-tab {
		appearance: none;
		border: 1px solid #cbd5e1;
		background: #ffffff;
		color: #334155;
		font-size: 0.82rem;
		font-weight: 700;
		padding: 0.45rem 0.95rem;
		border-radius: 9999px;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.cat-tab:hover {
		border-color: #64748b;
		color: #0f172a;
	}
	.cat-tab.is-active {
		background: #14213d;
		border-color: #14213d;
		color: #ffffff;
	}
	.tag-filter-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.tag-filter-label {
		font-size: 0.78rem;
		font-weight: 700;
		color: #64748b;
		margin-right: 0.25rem;
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
	}
	.tag-btn {
		appearance: none;
		border: 1px solid #e2e8f0;
		background: #f8fafc;
		color: #475569;
		font-size: 0.76rem;
		font-weight: 600;
		padding: 0.22rem 0.65rem;
		border-radius: 9999px;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.tag-btn:hover {
		border-color: #94a3b8;
		background: #ffffff;
		color: #0f172a;
	}
	.tag-btn.is-active {
		background: #2563eb;
		border-color: #2563eb;
		color: #ffffff;
	}
	.active-filter-status {
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 1rem;
		padding-top: 0.85rem;
		border-top: 1px dashed #cbd5e1;
		font-size: 0.84rem;
		color: #0f172a;
		font-weight: 600;
	}
	.active-filter-status.is-visible {
		display: flex;
	}
	.reset-filter-btn {
		appearance: none;
		border: 1px solid #cbd5e1;
		background: #ffffff;
		color: #475569;
		font-size: 0.76rem;
		font-weight: 700;
		padding: 0.26rem 0.7rem;
		border-radius: 6px;
		cursor: pointer;
	}

	/* 3カラム・ワイド記事グリッド */
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	.post-item {
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		overflow: hidden;
		background-color: #ffffff;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.post-item.is-hidden {
		display: none;
	}
	.post-item:hover {
		transform: translateY(-4px);
		border-color: #cbd5e1;
		box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
	}
	.post-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}
	.post-card-link:hover {
		text-decoration: none;
	}
	.post-img-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: #f1f5f9;
	}
	.post-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.35s ease;
	}
	.post-item:hover .post-img-wrap img {
		transform: scale(1.04);
	}
	.card-cat-badge {
		position: absolute;
		top: 0.7rem;
		left: 0.7rem;
		background: rgba(20, 33, 61, 0.88);
		color: #f8fafc;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.22rem 0.6rem;
		border-radius: 6px;
		backdrop-filter: blur(4px);
	}
	.post-content {
		padding: 1.25rem 1.35rem 1.35rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.date {
		font-size: 0.78rem;
		color: #64748b;
		margin-bottom: 0.4rem;
	}
	.title {
		font-size: 1.05rem;
		line-height: 1.5;
		margin: 0 0 0.6rem 0;
		color: #0f172a;
		font-weight: 700;
	}
	.post-item:hover .title {
		color: #2563eb;
	}
	.description {
		font-size: 0.85rem;
		color: #64748b;
		line-height: 1.65;
		margin: 0 0 0.9rem 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.38rem;
		margin-top: auto;
	}
	.card-tag {
		font-size: 0.72rem;
		font-weight: 600;
		color: #475569;
		background: #f1f5f9;
		padding: 0.14rem 0.5rem;
		border-radius: 5px;
	}

	@media (max-width: 1024px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 680px) {
		.wide-container {
			padding: 0 1.25rem;
		}
		.articles-band {
			padding: 2.25rem 0 3.5rem;
		}
		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}
</style>
